+++ b/tools/audio8/audio8-text-processor.h
@@ -0,0 +1,44 @@
+#pragma once
+
+#include "llama.h"
+
+#include <array>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace audio8 {
+
+using code_frame = std::array<int32_t, 10>;
+using prompt_column = std::array<int32_t, 11>;
+
+struct prepared_prompt {
+    std::string cleaned_text;
+    std::optional<std::string> formatted_reference_text;
+    std::vector<llama_token> prefix_ids;
+    std::vector<llama_token> suffix_ids;
+    std::vector<prompt_column> prompt_columns;
+    std::vector<int32_t> attention_mask;
+    int64_t context_remaining() const { return 2048 - int64_t(prompt_columns.size()); }
+};
+
+std::string clean_text(const std::string & text);
+std::string normalize_nfc(const std::string & text);
+std::string format_reference_text(const std::string & text);
+
+// The caller owns the model. A vocab-only model is sufficient.
+class text_processor {
+public:
+    explicit text_processor(const llama_model * model);
+    std::vector<llama_token> encode(const std::string & text) const;
+    prepared_prompt prepare(
+        const std::string & text,
+        const std::optional<std::string> & reference_text = std::nullopt,
+        const std::optional<std::vector<code_frame>> & reference_frames = std::nullopt) const;
+
+private:
+    const llama_vocab * vocab_;
+};
+
+} // namespace audio8
