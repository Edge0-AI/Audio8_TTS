+// Adjacent real/imaginary channels, matching the official Audio8 _apply_rope.
+// Separate MUL nodes deliberately retain product rounding before ADD/SUB.
+// These are ordinary GGML operations shared by CPU and CUDA; no trig is recomputed.
+static std::pair<ggml_tensor *, ggml_tensor *> audio8_rope_split(
+        ggml_context * ctx, ggml_tensor * x, int64_t n_head, int64_t n_tokens) {
+    // Q/K may be non-contiguous views into a fused QKV projection.
+    x = ggml_cont(ctx, x);
+    x = ggml_reshape_4d(ctx, x, 2, 32, n_head, n_tokens);
+    x = ggml_cont(ctx, ggml_permute(ctx, x, 1, 0, 2, 3)); // [32, 2, H, T]
+    auto * even = ggml_view_3d(ctx, x, 32, n_head, n_tokens, x->nb[2], x->nb[3], 0);
+    auto * odd  = ggml_view_3d(ctx, x, 32, n_head, n_tokens, x->nb[2], x->nb[3], x->nb[1]);
+    return { even, odd };
+}
+
+static ggml_tensor * audio8_rope_apply(
+        ggml_context * ctx, ggml_tensor * x, ggml_tensor * cos, ggml_tensor * sin) {
+    const int64_t n_head = x->ne[1];
+    const int64_t n_tokens = x->ne[2];
+    auto [even, odd] = audio8_rope_split(ctx, x, n_head, n_tokens);
+    auto * even_cos = ggml_mul(ctx, even, cos);
+    auto * odd_sin  = ggml_mul(ctx, odd, sin);
+    auto * odd_cos  = ggml_mul(ctx, odd, cos);
+    auto * even_sin = ggml_mul(ctx, even, sin);
+    auto * real = ggml_sub(ctx, even_cos, odd_sin);
+    auto * imag = ggml_add(ctx, odd_cos, even_sin);
+    real = ggml_reshape_4d(ctx, real, 32, 1, n_head, n_tokens);
+    imag = ggml_reshape_4d(ctx, imag, 32, 1, n_head, n_tokens);
+    auto * paired = ggml_concat(ctx, real, imag, 1); // [32, 2, H, T]
+    paired = ggml_cont(ctx, ggml_permute(ctx, paired, 1, 0, 2, 3));
+    return ggml_reshape_3d(ctx, paired, 64, n_head, n_tokens);
+}
