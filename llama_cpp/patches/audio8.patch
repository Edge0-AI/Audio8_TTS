+        if(values.count("--report")) { std::ofstream output(fs::u8path(values.at("--report")));output<<report.dump(2)<<'\n';if(!output) { throw std::runtime_error("Cannot write report"); } }
+        (request.streaming ? std::cerr : std::cout)<<report.dump()<<'\n';
+        return response.generation.stop_reason=="cancelled" ? 2 : 0;
+    } catch(const std::exception & error) { std::cerr<<"Audio8: "<<error.what()<<'\n';return 1; }
+}
+} // namespace audio8
