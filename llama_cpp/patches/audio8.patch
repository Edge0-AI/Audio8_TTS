diff --git a/tools/audio8/audio8-tts.cpp b/tools/audio8/audio8-tts.cpp
new file mode 100644
index 0000000..5db8968
--- /dev/null
+++ b/tools/audio8/audio8-tts.cpp
@@ -0,0 +1,218 @@
+#include "audio8-tts.h"
+#include "audio8-text-processor.h"
+#include "audio8-audio-io.h"
+#if defined(AUDIO8_CODEC_STREAM) && AUDIO8_CODEC_STREAM
+#include "audio8-codec-decoder-stream.h"
+#endif
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <mutex>
+#include <stdexcept>
+
+namespace audio8 {
+namespace {
+using clock_type=std::chrono::steady_clock;
+double milliseconds(clock_type::time_point start) { return std::chrono::duration<double,std::milli>(clock_type::now()-start).count(); }
+void require(bool value,const char * message) { if(!value) { throw std::invalid_argument(message); } }
+CodecCodes code_rows(const std::vector<std::vector<int>> & frames) {
+    CodecCodes result;result.frames=int(frames.size());result.values.resize(frames.size()*10);
+    for(size_t t=0;t<frames.size();++t) {
+        require(frames[t].size()==10,"Code frame must have ten values");
+        for(int c=0;c<10;++c) { result.values[size_t(c)*frames.size()+t]=frames[t][c]; }
+    }
+    return result;
+}
+std::vector<code_frame> code_frames(const CodecCodes & codes) {
+    require(codes.frames>0 && codes.values.size()==size_t(codes.frames)*10,"Invalid reference codes shape");
+    std::vector<code_frame> result(codes.frames);
+    for(int t=0;t<codes.frames;++t) {
+        for(int c=0;c<10;++c) {
+            const int value=codes.values[size_t(c)*codes.frames+t];
+            require(value>=0 && value<4096,"Reference codes outside [0,4096)");
+            result[t][c]=value;
+        }
+    }
+    return result;
+}
+#if defined(AUDIO8_CODEC_STREAM) && AUDIO8_CODEC_STREAM
+struct decoder_scope {
+    std::unique_ptr<CodecDecoderStream> stream;
+    bool finished=false;
+    ~decoder_scope() { if(stream && !finished) { stream->abort(); } }
+    void abort() noexcept { if(stream) { stream->abort(); } }
+    void finish() { stream->finish();finished=true; }
+};
+#endif
+}
+const char * tts_decode_policy(const tts_request & request) noexcept {
+    if(!request.streaming) { return "whole_utterance"; }
+#if defined(AUDIO8_CODEC_STREAM) && AUDIO8_CODEC_STREAM
+    if(!request.diagnostic_prefix_recompute) { return "cached_incremental_v1"; }
+#endif
+    return "full_prefix_recompute_v1";
+}
+struct tts_pipeline::impl {
+    clock_type::time_point loading_started=clock_type::now();
+    ar_engine ar;
+    text_processor processor;
+    Codec codec;
+    double loading_ms=0;
+    std::mutex mutex;
+    explicit impl(const tts_settings & settings):ar(settings.ar),processor(ar.text_model()),codec(settings.codec_model,settings.codec) {
+        loading_ms=milliseconds(loading_started);
+    }
+};
+tts_pipeline::tts_pipeline(const tts_settings & settings):impl_(new impl(settings)) {}
+tts_pipeline::~tts_pipeline()=default;
+double tts_pipeline::load_ms() const { return impl_->loading_ms; }
+tts_response tts_pipeline::generate(const tts_request & request,pcm_callback callback,cancellation_check cancel) {
+    const auto started=clock_type::now();
+    std::lock_guard<std::mutex> lock(impl_->mutex);
+    tts_response response;response.timings.queue_ms=milliseconds(started);
+    response.streaming_decode_policy=tts_decode_policy(request);
+    require(request.max_frames>0,"max_frames must be positive");request.sampling.validate();
+    require(request.chunk_frames>0 && request.chunk_frames<=512,"chunk_frames must be in [1,512]");
+    require(request.reference_audio_path.empty() || !request.reference_codes,"Provide reference audio or codes, not both");
+    bool downstream_cancelled=false;
+    auto cancelled=[&](){ return downstream_cancelled || (cancel && cancel()); };
+    if(cancelled()) { response.generation.stop_reason="cancelled";response.timings.total_ms=milliseconds(started);return response; }
+    std::optional<std::vector<code_frame>> reference;
+    if(!request.reference_audio_path.empty()) {
+        require(request.reference_text && !request.reference_text->empty(),"reference_text is required for reference audio");
+        auto start=clock_type::now();auto audio=read_audio(request.reference_audio_path);
+        response.timings.reference_audio_ms=milliseconds(start);
+        require(!audio.samples.empty() && audio.samples.size()<=4194304,"Reference audio length must be in [1,4194304]");
+        if(cancelled()) { response.generation.stop_reason="cancelled";response.timings.total_ms=milliseconds(started);return response; }
+        start=clock_type::now();auto codes=impl_->codec.encode(audio.samples.data(),int(audio.samples.size()));
+        response.timings.reference_encode_ms=milliseconds(start);reference=code_frames(codes);
+    } else if(request.reference_codes) { reference=code_frames(*request.reference_codes); }
+    auto start=clock_type::now();const auto prepared=impl_->processor.prepare(request.text,request.reference_text,reference);
+    response.timings.text_ms=milliseconds(start);response.prompt_tokens=prepared.prompt_columns.size();
+    require(prepared.context_remaining()>0,"Text and reference exceed 2048-token context");
+    ar_request generation;
+    for(const auto & column:prepared.prompt_columns) { generation.prompt_columns.emplace_back(column.begin(),column.end()); }
+    generation.max_frames=request.max_frames;generation.sampling=request.sampling;generation.seed=request.seed;
+    // Only the diagnostic/fallback path retains a second complete prefix.
+    std::vector<std::vector<int>> prefix,pending;
+    size_t decoded_frames=0;
+    bool cached=false;
+#if defined(AUDIO8_CODEC_STREAM) && AUDIO8_CODEC_STREAM
+    decoder_scope decoder;
+    cached=request.streaming && !request.diagnostic_prefix_recompute;
+    if(cached) { decoder.stream=std::make_unique<CodecDecoderStream>(impl_->codec); }
+#endif
+    auto abort_decoder=[&]() noexcept {
+#if defined(AUDIO8_CODEC_STREAM) && AUDIO8_CODEC_STREAM
+        decoder.abort();
+#endif
+    };
+    double callback_ms=0;
+    auto deliver=[&](const std::vector<float> & chunk,size_t offset) {
+        if(cancelled()) { return false; }
+        require(offset==response.pcm.size(),"Streaming PCM sample offset is discontinuous");
+        for(float value:chunk) { require(std::isfinite(value),"Nonfinite PCM"); }
+        if(chunk.empty()) { return true; }
+        // Cancellation may arrive during codec execution or validation.
+        if(cancelled()) { return false; }
+        response.pcm.insert(response.pcm.end(),chunk.begin(),chunk.end());
+        if(response.timings.first_pcm_ms<0) { response.timings.first_pcm_ms=milliseconds(started); }
+        ++response.emitted_chunks;
+        return !callback || callback(chunk,offset);
+    };
+    auto timed_decode=[&](auto operation) {
+        const auto decode_start=clock_type::now();
+        try {
+            auto value=operation();response.timings.codec_decode_ms+=milliseconds(decode_start);return value;
+        } catch(...) { response.timings.codec_decode_ms+=milliseconds(decode_start);throw; }
+    };
+    auto decode_prefix=[&]() {
+        if(prefix.empty()) { return true; }
+        const auto rows=code_rows(prefix);
+        const auto complete=timed_decode([&](){ return impl_->codec.decode(rows.values.data(),rows.frames); });
+        require(complete.size()==prefix.size()*Codec::frame_length,"Codec returned wrong PCM length");
+        require(complete.size()>=response.pcm.size(),"Streaming decoder prefix shrank");
+        const std::vector<float> chunk(complete.begin()+response.pcm.size(),complete.end());
+        return deliver(chunk,response.pcm.size());
+    };
+    auto decode_pending=[&]() -> bool {
+        if(pending.empty()) { return true; }
+#if defined(AUDIO8_CODEC_STREAM) && AUDIO8_CODEC_STREAM
+        require(cached && decoder.stream,"Incremental decoder is unavailable");
+        const auto rows=code_rows(pending);
+        const auto chunk=timed_decode([&](){ return decoder.stream->push(rows.values,rows.frames,{},cancelled); });
+        require(chunk.frame_offset>=0 && size_t(chunk.frame_offset)==decoded_frames,"Streaming codec frame offset mismatch");
+        require(chunk.sample_offset==decoded_frames*size_t(Codec::frame_length),"Streaming codec sample offset mismatch");
+        require(chunk.pcm.size()==pending.size()*Codec::frame_length,"Streaming codec returned wrong delta length");
+        require(decoder.stream->position()==int(decoded_frames+pending.size()),"Streaming codec position mismatch");
+        decoded_frames+=pending.size();pending.clear();
+        return deliver(chunk.pcm,size_t(chunk.sample_offset));
+#else
+        throw std::logic_error("Incremental codec was not compiled");
+#endif
+    };
+    try {
+        start=clock_type::now();
+        response.generation=impl_->ar.generate(generation,[&](const frame_event & frame) {
+            if(!request.streaming) { return true; }
+            const auto callback_start=clock_type::now();
+            bool keep_going=true;
+            try {
+                if(cancelled()) { keep_going=false; }
+                else if(cached) {
+                    pending.push_back(frame.codes);
+                    if(pending.size()==size_t(request.chunk_frames)) { keep_going=decode_pending(); }
+                } else {
+                    prefix.push_back(frame.codes);
+                    if(prefix.size()%size_t(request.chunk_frames)==0) { keep_going=decode_prefix(); }
+                }
+            }
+#if defined(AUDIO8_CODEC_STREAM) && AUDIO8_CODEC_STREAM
+              catch(const CodecDecoderCancelled &) { keep_going=false;abort_decoder(); }
+              catch(const CodecPostCancelled &) { keep_going=false;abort_decoder(); }
+#endif
+              catch(...) {
+                abort_decoder();
+                if(cancelled()) { keep_going=false; }
+                else { callback_ms+=milliseconds(callback_start);throw; }
+            }
+            callback_ms+=milliseconds(callback_start);downstream_cancelled=downstream_cancelled || !keep_going;
+            return keep_going;
+        },cancelled);
+        response.timings.ar_ms=std::max(0.0,milliseconds(start)-callback_ms);
+        if(cancelled()) { response.generation.stop_reason="cancelled"; }
+        if(response.generation.stop_reason=="max_frames" && !request.allow_partial) {
+            throw generation_limit_error("Generation reached frame budget without EOS; increase max_frames or explicitly allow_partial");
+        }
+        if(response.generation.stop_reason!="cancelled") {
+            require(!response.generation.frames.empty(),"Model emitted no audio frames");
+            bool keep_going=true;
+            if(cached) {
+                keep_going=decode_pending();
+#if defined(AUDIO8_CODEC_STREAM) && AUDIO8_CODEC_STREAM
+                if(keep_going && !cancelled()) {
+                    require(decoded_frames==response.generation.frames.size(),"Streaming decoder did not consume every generated frame");
+                    decoder.finish(); // No extra PCM is returned; terminal transpose tails are dropped.
+                }
+#endif
+            } else {
+                prefix=response.generation.frames;
+                if(!request.streaming || response.pcm.size()!=prefix.size()*Codec::frame_length) { keep_going=decode_prefix(); }
+            }
+            if(!keep_going || cancelled()) { downstream_cancelled=true;response.generation.stop_reason="cancelled"; }
+        }
+    }
+#if defined(AUDIO8_CODEC_STREAM) && AUDIO8_CODEC_STREAM
+      catch(const CodecDecoderCancelled &) { downstream_cancelled=true;response.generation.stop_reason="cancelled"; }
+      catch(const CodecPostCancelled &) { downstream_cancelled=true;response.generation.stop_reason="cancelled"; }
+#endif
+      catch(...) {
+        abort_decoder();
+        if(cancelled()) { response.generation.stop_reason="cancelled"; }
+        else { throw; }
+    }
+    if(response.generation.stop_reason=="cancelled") { abort_decoder(); }
+    response.timings.total_ms=milliseconds(started);
+    return response;
+}
+} // namespace audio8
diff --git a/tools/audio8/audio8-tts.h b/tools/audio8/audio8-tts.h
new file mode 100644
index 0000000..53633e2
--- /dev/null
+++ b/tools/audio8/audio8-tts.h
@@ -0,0 +1,68 @@
+#pragma once
+#include "audio8-ar-engine.h"
+#include "audio8-codec-native.h"
+#include <functional>
+#include <memory>
+#include <optional>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace audio8 {
+class generation_limit_error:public std::runtime_error {
+public: using std::runtime_error::runtime_error;
+};
+struct tts_settings {
+    engine_settings ar;
+    std::string codec_model;
+    CodecOptions codec;
+};
+struct tts_request {
+    std::string text;
+    std::optional<std::string> reference_text;
+    std::string reference_audio_path;
+    std::optional<CodecCodes> reference_codes;
+    int max_frames = 512;
+    sampling_options sampling;
+    uint32_t seed = 0;
+    bool streaming = false;
+    int chunk_frames = 12;
+    bool allow_partial = false;
+    // Internal regression switch; normal CLI/HTTP requests leave this false.
+    bool diagnostic_prefix_recompute = false;
+};
+struct tts_timings {
+    double queue_ms = 0;
+    double text_ms = 0;
+    double reference_audio_ms = 0;
+    double reference_encode_ms = 0;
+    double ar_ms = 0;
+    double codec_decode_ms = 0;
+    double first_pcm_ms = -1;
+    double total_ms = 0;
+};
+struct tts_response {
+    std::vector<float> pcm;
+    ar_response generation;
+    tts_timings timings;
+    size_t prompt_tokens = 0;
+    size_t emitted_chunks = 0;
+    std::string streaming_decode_policy = "whole_utterance";
+};
+// Selected policy from the actual linked pipeline build, including its fallback.
+const char * tts_decode_policy(const tts_request & request) noexcept;
+// Return false after receiving a whole PCM chunk to request cancellation.
+using pcm_callback=std::function<bool(const std::vector<float> &,size_t sample_offset)>;
+class tts_pipeline {
+public:
+    explicit tts_pipeline(const tts_settings & settings);
+    ~tts_pipeline();
+    tts_pipeline(const tts_pipeline &)=delete;
+    tts_pipeline & operator=(const tts_pipeline &)=delete;
+    tts_response generate(const tts_request & request,pcm_callback callback={},cancellation_check cancel={});
+    double load_ms() const;
+private:
+    struct impl;
+    std::unique_ptr<impl> impl_;
+};
+} // namespace audio8
