@@ -0,0 +1,802 @@
+// Implements the published Audio8 codec equations and tensor hierarchy.
+// Source reference: locked modeling_arktts_codec.py, SHA e1d6b0e1...3ede68.
+// This independent baseline does not import audio.cpp framework code or kernels.
+#include "audio8-codec-native.h"
+#include "audio8-codec-post-stream.h"
+#include "audio8-codec-decoder-stream.h"
+#include "ggml.h"
+#include "ggml-cpu.h"
+#include "gguf.h"
+#ifdef AUDIO8_CODEC_CUDA
+#include "ggml-backend.h"
+#include "ggml-alloc.h"
+#include "ggml-cuda.h"
+#endif
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstdlib>
+#include <cstring>
+#include <limits>
+#include <stdexcept>
+#include <unordered_map>
+
+namespace audio8 {
+namespace {
+using Tensor = CodecPostTensor; // same channel-fast storage; zero-copy internal bridge
+struct ContextFree { void operator()(ggml_context * p) const { if (p) ggml_free(p); } };
+using Context = std::unique_ptr<ggml_context, ContextFree>;
+using TimingMap = std::unordered_map<std::string, std::pair<double,uint64_t>>;
+struct Timer {
+    std::pair<double,uint64_t> * entry = nullptr;
+    std::chrono::steady_clock::time_point start;
+    Timer(TimingMap & timings, bool enabled, const char * name) {
+        if(enabled) { entry=&timings[name]; start=std::chrono::steady_clock::now(); }
+    }
+    ~Timer() { if(entry) { entry->first+=std::chrono::duration<double>(std::chrono::steady_clock::now()-start).count(); ++entry->second; } }
+};
+#ifdef AUDIO8_CODEC_CUDA
+struct BufferFree { void operator()(ggml_backend_buffer * p) const { if (p) ggml_backend_buffer_free(p); } };
+using Buffer = std::unique_ptr<ggml_backend_buffer, BufferFree>;
+struct DeviceWeight {
+    Context context;
+    Buffer buffer;
+    ggml_tensor * tensor = nullptr;
+};
+#endif
+std::string parent_conv(const std::string & name) {
+    return name.size() >= 5 && name.substr(name.size()-5) == ".conv" ? name.substr(0, name.size()-5) : name;
+}
+void require(bool value, const std::string & why) { if (!value) throw std::runtime_error(why); }
+}
+
+struct Codec::Impl {
+    gguf_context * gguf = nullptr;
+    ggml_context * weights = nullptr;
+    ggml_threadpool_t pool = nullptr;
+    int threads;
+    bool collect_timings;
+    TimingMap timings;
+    CodecTrace trace;
+    std::vector<uint8_t> work;
+    std::unordered_map<std::string, std::vector<float>> transposed_weights;
+#ifdef AUDIO8_CODEC_CUDA
+    ggml_backend_t cuda_backend = nullptr;
+    std::unordered_map<const float *, std::unique_ptr<DeviceWeight>> device_weights;
+#endif
+
+    explicit Impl(const std::string & path, const CodecOptions & options) : threads(options.threads), collect_timings(options.collect_timings) {
+        require(threads >= 1 && threads <= 64, "codec threads must be in [1,64]");
+        ggml_cpu_init();
+        gguf_init_params params{false, &weights};
+        gguf = gguf_init_from_file(path.c_str(), params);
+        require(gguf && weights, "cannot load codec GGUF");
+        try {
+            string_meta("general.architecture", "audio8_codec");
+            string_meta("audio8.codec.format", "native_f32_v1");
+            string_meta("audio8.codec.source_sha256", "c310505aa11fe2f6cc63b8d3130dc7e77e73227774f5c62575769b1f47a8d048");
+            string_meta("audio8.codec.rope_policy", "official_cpu_bf16_promoted_f32");
+            for (int64_t i=0; i<gguf_get_n_tensors(gguf); ++i) {
+                auto * tensor=ggml_get_tensor(weights,gguf_get_tensor_name(gguf,i));
+                require(tensor && tensor->type == GGML_TYPE_F32, "codec baseline requires every stored tensor to be F32");
+            }
+            auto p = ggml_threadpool_params_default(threads);
+            pool = ggml_threadpool_new(&p);
+            require(pool != nullptr, "cannot create GGML CPU thread pool");
+            auto * rope = weight("audio8.codec.rope_coeffs.weight");
+            require(rope->ne[0] == 64 && rope->ne[1] == 8192 && rope->ne[2] == 1 && rope->ne[3] == 1,
+                    "codec RoPE shape must be [64,8192]");
+            if (options.backend == CodecBackend::CUDA) {
+#ifdef AUDIO8_CODEC_CUDA
+                const char * tf32 = std::getenv("NVIDIA_TF32_OVERRIDE");
+                require(tf32 && std::strcmp(tf32, "0") == 0, "CUDA codec requires NVIDIA_TF32_OVERRIDE=0");
+                require(std::getenv("GGML_CUDA_CUBLAS_COMPUTE_TYPE") == nullptr,
+                        "CUDA codec requires GGML_CUDA_CUBLAS_COMPUTE_TYPE unset");
+                require(options.device >= 0, "CUDA codec device must be nonnegative");
+                cuda_backend = ggml_backend_cuda_init(options.device);
+                require(cuda_backend != nullptr, "cannot initialize codec CUDA backend");
+#else
+                throw std::runtime_error("codec was built without AUDIO8_CODEC_CUDA");
+#endif
+            }
+        } catch (...) {
+            if (pool) ggml_threadpool_free(pool);
+            ggml_free(weights); gguf_free(gguf); weights = nullptr; gguf = nullptr;
+            throw;
+        }
+    }
+    ~Impl() {
+#ifdef AUDIO8_CODEC_CUDA
+        device_weights.clear();
+        if (cuda_backend) ggml_backend_free(cuda_backend);
+#endif
+        if (pool) ggml_threadpool_free(pool);
+        if (weights) ggml_free(weights);
+        if (gguf) gguf_free(gguf);
+    }
+    void string_meta(const char * key, const char * expected) {
+        const int64_t id = gguf_find_key(gguf, key);
+        require(id >= 0 && gguf_get_kv_type(gguf, id) == GGUF_TYPE_STRING, std::string("missing STRING ")+key);
+        require(std::strcmp(gguf_get_val_str(gguf, id), expected) == 0, std::string("unsupported codec metadata ")+key);
+    }
+    ggml_tensor * weight(const std::string & name) const {
+        auto * w = ggml_get_tensor(weights, name.c_str());
+        require(w != nullptr, "missing codec tensor: "+name);
+        require(w->type == GGML_TYPE_F32 && ggml_is_contiguous(w), "non-F32/contiguous tensor: "+name);
+        return w;
+    }
+    const float * values(const std::string & name, size_t count = 0) const {
+        auto * w = weight(name);
+        require(!count || size_t(ggml_nelements(w)) == count, "wrong tensor size: "+name);
+        return static_cast<const float *>(w->data);
+    }
+    void emit(const std::string & name, const Tensor & x) {
+        if (trace) trace(name, x.data.data(), x.t, x.c);
+    }
+    bool parallel_cpu() const {
+#ifdef AUDIO8_CODEC_CUDA
+        return cuda_backend != nullptr;
+#else
+        return false;
+#endif
+    }
+    int convolution_chunk() const { return parallel_cpu() ? 2048 : 256; }
+#ifdef AUDIO8_CODEC_CUDA
+    std::unique_ptr<DeviceWeight> upload_weight(const float * w, int out, int in) {
+        Timer timer(timings,collect_timings,"cuda.weight_upload");
+        auto d = std::make_unique<DeviceWeight>();
+        d->context.reset(ggml_init({ggml_tensor_overhead()*4, nullptr, true}));
+        require(bool(d->context), "cannot allocate codec CUDA weight metadata");
+        d->tensor = ggml_new_tensor_2d(d->context.get(), GGML_TYPE_F32, in, out);
+        d->buffer.reset(ggml_backend_alloc_ctx_tensors(d->context.get(), cuda_backend));
+        require(bool(d->buffer), "cannot allocate codec CUDA weight buffer");
+        ggml_backend_buffer_set_usage(d->buffer.get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+        ggml_backend_tensor_set(d->tensor, w, 0, size_t(in)*out*sizeof(float));
+        return d;
+    }
+    ggml_tensor * cached_weight(const float * w,int out,int in) {
+        auto found=device_weights.find(w);
+        if(found==device_weights.end()) found=device_weights.emplace(w,upload_weight(w,out,in)).first;
+        auto * t=found->second->tensor;
+        require(t->ne[0]==in && t->ne[1]==out,"CUDA weight cache shape mismatch");
+        return t;
+    }
+    ggml_tensor * graph_bias(ggml_context * ctx,ggml_tensor * x,const std::string & name) {
+        auto * b=ggml_get_tensor(weights,(name+".bias").c_str());
+        if(!b) return x;
+        return ggml_add(ctx,x,cached_weight(values(name+".bias",x->ne[0]),1,int(x->ne[0])));
+    }
+    ggml_tensor * graph_snake(ggml_context * ctx,ggml_tensor * x,const std::string & name) {
+        const int channels=int(x->ne[0]);
+        const float * alpha=values(name+".alpha",channels);
+        auto found=transposed_weights.find("reciprocal:"+name);
+        if(found==transposed_weights.end()) {
+            std::vector<float> reciprocal(channels);
+            for(int c=0;c<channels;++c) reciprocal[c]=1.0f/(alpha[c]+1.0e-9f);
+            found=transposed_weights.emplace("reciprocal:"+name,std::move(reciprocal)).first;
+        }
+        auto * a=cached_weight(alpha,1,channels);
+        auto * inv=cached_weight(found->second.data(),1,channels);
+        auto * s=ggml_sin(ctx,ggml_mul(ctx,x,a));
+        return ggml_add(ctx,x,ggml_mul(ctx,ggml_sqr(ctx,s),inv));
+    }
+    ggml_tensor * graph_conv(ggml_context * ctx,ggml_tensor * x,const std::string & name,int stride=1,int dilation=1,bool causal=true) {
+        auto * w=weight(name+".weight");
+        const int k=int(w->ne[0]),cin=int(w->ne[1]),cout=int(w->ne[2]);
+        require(cin==x->ne[0] && k>0 && k<=31 && w->ne[3]==1,"invalid CUDA graph convolution: "+name);
+        auto * a=cached_weight(static_cast<float *>(w->data),cout,cin*k);
+        ggml_tensor * col=x;
+        if(k!=1 || stride!=1 || dilation!=1) {
+            const int pad=causal ? (k-1)*dilation+1-stride : 0;
+            require(pad>=0,"invalid CUDA causal padding");
+            auto * kernel=ggml_reshape_3d(ctx,a,k,cin,cout);
+            auto * channel_first=ggml_cont(ctx,ggml_transpose(ctx,x));
+            auto * all=ggml_im2col(ctx,kernel,channel_first,stride,0,pad,0,dilation,0,false,GGML_TYPE_F32);
+            const int64_t tout=causal ? (x->ne[1]+stride-1)/stride : (x->ne[1]-(k-1)*dilation-1)/stride+1;
+            // im2col has symmetric padding; retain only causal outputs before the right extension.
+            require(all->ne[1]>=tout,"CUDA im2col produced too few causal frames");
+            col=ggml_view_2d(ctx,all,cin*k,tout,all->nb[1],0);
+        }
+        auto * y=ggml_mul_mat(ctx,a,col);
+        require(ggml_prec_set_acc(y,GGML_PREC_F32),"cannot set codec F32 accumulation");
+        return graph_bias(ctx,y,name);
+    }
+    Tensor execute_cuda_graph(ggml_context * ctx,ggml_tensor * input,ggml_tensor * output,const Tensor & x) {
+        Tensor y(int(output->ne[0]),int(output->ne[1]));
+        auto * graph=ggml_new_graph_custom(ctx,256,false);
+        ggml_build_forward_expand(graph,output);
+        for(int i=0;i<ggml_graph_n_nodes(graph);++i)
+            require(ggml_backend_supports_op(cuda_backend,ggml_graph_node(graph,i)),"unsupported codec CUDA graph operation");
+        Buffer buffer;
+        { Timer timer(timings,collect_timings,"cuda.activation_allocation");
+          buffer.reset(ggml_backend_alloc_ctx_tensors(ctx,cuda_backend)); }
+        require(bool(buffer),"cannot allocate codec CUDA graph buffer");
+        { Timer timer(timings,collect_timings,"cuda.h2d");
+          ggml_backend_tensor_set(input,x.data.data(),0,x.data.size()*sizeof(float)); }
+        { Timer timer(timings,collect_timings,"cuda.graph_compute");
+          require(ggml_backend_graph_compute(cuda_backend,graph)==GGML_STATUS_SUCCESS,"codec CUDA graph failed"); }
+        { Timer timer(timings,collect_timings,"cuda.d2h");
+          ggml_backend_tensor_get(output,y.data.data(),0,y.data.size()*sizeof(float)); }
+        return y;
+    }
+    Context cuda_graph_context() {
+        Context ctx(ggml_init({ggml_tensor_overhead()*256+ggml_graph_overhead_custom(256,false),nullptr,true}));
+        require(bool(ctx),"cannot allocate codec CUDA graph metadata");
+        return ctx;
+    }
+    Tensor cuda_conv(const Tensor & x,const std::string & name,int stride,int dilation,bool causal=true) {
+        Timer timer(timings,collect_timings,"cuda.convolution_total");
+        auto ctx=cuda_graph_context();
+        auto * input=ggml_new_tensor_2d(ctx.get(),GGML_TYPE_F32,x.c,x.t);
+        auto * output=graph_conv(ctx.get(),input,name,stride,dilation,causal);
+        return execute_cuda_graph(ctx.get(),input,output,x);
+    }
+    Tensor cuda_residual(const Tensor & x,const std::string & name,int dilation) {
+        Timer timer(timings,collect_timings,"cuda.residual_total");
+        auto ctx=cuda_graph_context();
+        auto * input=ggml_new_tensor_2d(ctx.get(),GGML_TYPE_F32,x.c,x.t);
+        auto * y=graph_snake(ctx.get(),input,name+".block.0");
+        y=graph_conv(ctx.get(),y,name+".block.1.conv",1,dilation);
+        y=graph_snake(ctx.get(),y,name+".block.2");
+        y=graph_conv(ctx.get(),y,name+".block.3.conv");
+        y=ggml_add(ctx.get(),input,y);
+        return execute_cuda_graph(ctx.get(),input,y,x);
+    }
+    Tensor input_window(const Tensor & x,int begin,int count) {
+        require(count>0,"empty CUDA codec window");
+        Tensor tile(x.c,count);
+        const int lo=std::max(0,begin),hi=std::min(x.t,begin+count);
+        if(hi>lo) std::copy_n(x.data.data()+size_t(lo)*x.c,size_t(hi-lo)*x.c,
+                             tile.data.data()+size_t(lo-begin)*x.c);
+        return tile;
+    }
+    Tensor cuda_conv_tiled(const Tensor & x,const std::string & name,int stride,int dilation) {
+        Timer timer(timings,collect_timings,"cuda.tiled_convolution_total");
+        auto * w=weight(name+".weight");
+        const int k=int(w->ne[0]),cout=int(w->ne[2]);
+        const int pad=(k-1)*dilation+1-stride;
+        require(pad>=0,"invalid CUDA tiled causal padding");
+        const int tout=(x.t+stride-1)/stride;
+        Tensor y(cout,tout);
+        const int chunk=std::max(256,std::min(16384,int((uint64_t(32)*1024*1024)/(x.c*k))));
+        for(int start=0;start<tout;start+=chunk) {
+            const int count=std::min(chunk,tout-start);
+            // Explicit left history and right zero padding; valid convolution yields count outputs.
+            auto tile=input_window(x,start*stride-pad,count*stride+pad);
+            auto output=cuda_conv(tile,name,stride,dilation,false);
+            require(output.c==cout && output.t==count,"CUDA tiled convolution shape mismatch");
+            std::copy(output.data.begin(),output.data.end(),y.data.begin()+size_t(start)*cout);
+        }
+        return y;
+    }
+    Tensor cuda_residual_tiled(const Tensor & x,const std::string & name,int dilation) {
+        Timer timer(timings,collect_timings,"cuda.tiled_residual_total");
+        // Only the first k=7 convolution has temporal extent; the second is k=1.
+        // Preserve its complete left history, then discard halo outputs after the unit.
+        const int pad=6*dilation;
+        const int chunk=std::max(256,std::min(16384,int((uint64_t(32)*1024*1024)/(x.c*7))-pad));
+        Tensor y(x.c,x.t);
+        for(int start=0;start<x.t;start+=chunk) {
+            const int count=std::min(chunk,x.t-start);
+            auto tile=input_window(x,start-pad,count+pad);
+            auto output=cuda_residual(tile,name,dilation);
+            std::copy_n(output.data.data()+size_t(pad)*x.c,size_t(count)*x.c,y.data.data()+size_t(start)*x.c);
+        }
+        return y;
+    }
+    Tensor cuda_transpose_conv(const Tensor & x,const float * reordered,int cout,int k,int stride,const std::string & name) {
+        Timer timer(timings,collect_timings,"cuda.transpose_convolution_total");
+        auto ctx=cuda_graph_context();
+        auto * input=ggml_new_tensor_2d(ctx.get(),GGML_TYPE_F32,x.c,x.t);
+        auto * a=cached_weight(reordered,cout*k,x.c);
+        auto * columns=ggml_mul_mat(ctx.get(),a,input);
+        require(ggml_prec_set_acc(columns,GGML_PREC_F32),"cannot set codec F32 accumulation");
+        auto * all=ggml_col2im_1d(ctx.get(),columns,stride,cout,0);
+        auto * causal=ggml_view_2d(ctx.get(),all,x.t*stride,cout,all->nb[1],0);
+        auto * y=ggml_cont(ctx.get(),ggml_transpose(ctx.get(),causal));
+        y=graph_bias(ctx.get(),y,name);
+        return execute_cuda_graph(ctx.get(),input,y,x);
+    }
+    Tensor cuda_matmul(const float * w, int out, int in, const Tensor & x, bool cache_weight) {
+        std::unique_ptr<DeviceWeight> transient;
+        DeviceWeight * d;
+        if (cache_weight) {
+            auto found = device_weights.find(w);
+            if (found == device_weights.end()) found = device_weights.emplace(w, upload_weight(w, out, in)).first;
+            d = found->second.get();
+            require(d->tensor->ne[0] == in && d->tensor->ne[1] == out, "CUDA weight cache shape mismatch");
+        } else {
+            // Normalized VQ codebooks have temporary storage; never cache their address.
+            transient = upload_weight(w, out, in); d = transient.get();
+        }
+        Tensor y(out, x.t);
+        Context ctx(ggml_init({ggml_tensor_overhead()*16 + ggml_graph_overhead_custom(16, false), nullptr, true}));
+        require(bool(ctx), "cannot allocate codec CUDA graph metadata");
+        auto * b = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_F32, in, x.t);
+        auto * c = ggml_mul_mat(ctx.get(), d->tensor, b);
+        require(ggml_prec_set_acc(c,GGML_PREC_F32),"cannot set codec F32 accumulation");
+        auto * graph = ggml_new_graph_custom(ctx.get(), 16, false);
+        ggml_build_forward_expand(graph, c);
+        // d->tensor belongs to its persistent context; this buffer owns only B/C.
+        Buffer buffer;
+        { Timer timer(timings,collect_timings,"cuda.activation_allocation");
+          buffer.reset(ggml_backend_alloc_ctx_tensors(ctx.get(), cuda_backend)); }
+        require(bool(buffer), "cannot allocate codec CUDA activation buffer");
+        require(ggml_backend_supports_op(cuda_backend, c), "CUDA does not support codec F32 matmul");
+        { Timer timer(timings,collect_timings,"cuda.h2d");
+          ggml_backend_tensor_set(b, x.data.data(), 0, x.data.size()*sizeof(float)); }
+        { Timer timer(timings,collect_timings,"cuda.graph_compute");
+          require(ggml_backend_graph_compute(cuda_backend, graph) == GGML_STATUS_SUCCESS, "codec CUDA matmul failed"); }
+        { Timer timer(timings,collect_timings,"cuda.d2h");
+          ggml_backend_tensor_get(c, y.data.data(), 0, y.data.size()*sizeof(float)); }
+        return y;
+    }
+#endif
+    Tensor matmul(const float * w, int out, int in, const Tensor & x, bool cache_weight=true) {
+        Timer timer(timings,collect_timings,"matmul.total");
+        require(in == x.c && in > 0 && out > 0, "invalid codec matmul dimensions");
+#ifdef AUDIO8_CODEC_CUDA
+        if (cuda_backend) return cuda_matmul(w, out, in, x, cache_weight);
+#else
+        (void) cache_weight;
+#endif
+        Tensor y(out, x.t);
+        ggml_init_params init{ggml_tensor_overhead()*16 + ggml_graph_overhead_custom(16, false), nullptr, true};
+        Context ctx(ggml_init(init));
+        require(bool(ctx), "cannot allocate codec graph metadata");
+        auto * a = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_F32, in, out);
+        auto * b = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_F32, in, x.t);
+        a->data = const_cast<float *>(w);
+        b->data = const_cast<float *>(x.data.data());
+        auto * c = ggml_mul_mat(ctx.get(), a, b);
+        require(ggml_prec_set_acc(c,GGML_PREC_F32),"cannot set codec F32 accumulation");
+        c->data = y.data.data();
+        auto * graph = ggml_new_graph_custom(ctx.get(), 16, false);
+        ggml_build_forward_expand(graph, c);
+        auto plan = ggml_graph_plan(graph, threads, pool);
+        work.resize(plan.work_size);
+        plan.work_data = work.empty() ? nullptr : work.data();
+        require(ggml_graph_compute(graph, &plan) == GGML_STATUS_SUCCESS, "codec GGML matmul failed");
+        return y;
+    }
+    void bias(Tensor & x, const std::string & name) {
+        auto * w = ggml_get_tensor(weights, (name+".bias").c_str());
+        if (!w) return;
+        const float * b = values(name+".bias", x.c);
+        #pragma omp parallel for if(parallel_cpu() && x.t>256) num_threads(threads)
+        for (int t=0; t<x.t; ++t) for (int c=0; c<x.c; ++c) x.data[size_t(t)*x.c+c] += b[c];
+    }
+    Tensor linear(const Tensor & x, const std::string & name, bool record=false) {
+        auto * w = weight(name+".weight");
+        require(w->ne[0] == x.c && w->ne[2] == 1 && w->ne[3] == 1, "invalid linear shape: "+name);
+        auto y = matmul(static_cast<float *>(w->data), int(w->ne[1]), x.c, x);
+        bias(y,name);
+        if (record) emit(name,y);
+        return y;
+    }
+    Tensor conv(const Tensor & x, const std::string & name, int stride=1, int dilation=1, bool depthwise=false) {
+        auto * w = weight(name+".weight");
+        const int k=int(w->ne[0]), cin=int(w->ne[1]), cout=int(w->ne[2]);
+        require(k>0 && k<=31 && stride>0 && dilation>0 && w->ne[3]==1, "invalid convolution: "+name);
+        require(depthwise ? (cin==1 && cout==x.c) : cin==x.c, "conv channels mismatch: "+name);
+#ifdef AUDIO8_CODEC_CUDA
+        // Bound graph temporaries without reverting long inputs to host im2col.
+        if(cuda_backend && !depthwise) {
+            auto y=uint64_t(x.t)*cin*k<=uint64_t(256)*1024*1024 ?
+                cuda_conv(x,name,stride,dilation) : cuda_conv_tiled(x,name,stride,dilation);
+            emit(parent_conv(name),y); return y;
+        }
+#endif
+        const int pad=(k-1)*dilation+1-stride;
+        require(pad>=0, "negative causal padding: "+name);
+        const int tout=(x.t+stride-1)/stride;
+        Tensor y(cout,tout);
+        const float * data=static_cast<float *>(w->data);
+        if (depthwise) {
+            #pragma omp parallel for if(parallel_cpu() && tout>256) num_threads(threads)
+            for (int t=0;t<tout;++t) for(int c=0;c<cout;++c) {
+                float sum=0;
+                for(int j=0;j<k;++j) {
+                    const int ti=t*stride+j*dilation-pad;
+                    if(ti>=0 && ti<x.t) sum+=x.data[size_t(ti)*x.c+c]*data[size_t(c)*k+j];
+                }
+                y.data[size_t(t)*cout+c]=sum;
+            }
+        } else {
+            // Explicit FP32 im2col: fixed upstream ggml_conv_1d defaults to F16.
+            const int chunk=convolution_chunk();
+            for(int start=0;start<tout;start+=chunk) {
+                const int count=std::min(chunk,tout-start);
+                Tensor col(cin*k,count);
+                { Timer timer(timings,collect_timings,"cpu.im2col");
+                #pragma omp parallel for if(parallel_cpu() && count>256) num_threads(threads)
+                for(int t=0;t<count;++t) for(int c=0;c<cin;++c) for(int j=0;j<k;++j) {
+                    const int ti=(start+t)*stride+j*dilation-pad;
+                    if(ti>=0 && ti<x.t) col.data[size_t(t)*col.c+c*k+j]=x.data[size_t(ti)*x.c+c];
+                }
+                }
+                auto block=matmul(data,cout,cin*k,col);
+                std::copy(block.data.begin(),block.data.end(),y.data.begin()+size_t(start)*cout);
+            }
+        }
+        bias(y,name); emit(parent_conv(name),y); return y;
+    }
+    Tensor transpose_conv(const Tensor & x,const std::string & name,int stride) {
+        auto * w=weight(name+".weight");
+        const int k=int(w->ne[0]),cout=int(w->ne[1]),cin=int(w->ne[2]);
+        require(cin==x.c && k>=stride && k<=32 && w->ne[3]==1,"invalid transpose convolution: "+name);
+        auto it=transposed_weights.find(name);
+        if(it==transposed_weights.end()) {
+            std::vector<float> reordered(size_t(cin)*cout*k);
+            const float * raw=static_cast<float *>(w->data);
+            for(int ci=0;ci<cin;++ci) for(int co=0;co<cout;++co) for(int j=0;j<k;++j)
+                reordered[(size_t(co)*k+j)*cin+ci]=raw[(size_t(ci)*cout+co)*k+j];
+            it=transposed_weights.emplace(name,std::move(reordered)).first;
+        }
+#ifdef AUDIO8_CODEC_CUDA
+        if(cuda_backend && uint64_t(x.t)*cout*k<=uint64_t(256)*1024*1024) {
+            auto y=cuda_transpose_conv(x,it->second.data(),cout,k,stride,name); emit(parent_conv(name),y); return y;
+        }
+#endif
+        Tensor y(cout,x.t*stride); // official right crop is exactly kernel-stride
+        const int chunk=convolution_chunk();
+        for(int start=0;start<x.t;start+=chunk) {
+            const int count=std::min(chunk,x.t-start);
+            Tensor input(cin,count);
+            std::copy_n(x.data.data()+size_t(start)*cin,input.data.size(),input.data.data());
+            auto p=matmul(it->second.data(),cout*k,cin,input);
+            { Timer timer(timings,collect_timings,"cpu.overlap_add");
+            // Partition channels, not time: adjacent input frames overlap.
+            #pragma omp parallel for if(parallel_cpu() && count>256) num_threads(threads)
+            for(int co=0;co<cout;++co) for(int t=0;t<count;++t) for(int j=0;j<k;++j) {
+                const int ti=(start+t)*stride+j;
+                if(ti<y.t) y.data[size_t(ti)*cout+co]+=p.data[size_t(t)*(cout*k)+co*k+j];
+            }
+            }
+        }
+        bias(y,name); emit(parent_conv(name),y); return y;
+    }
+    Tensor snake(const Tensor & x,const std::string & name) {
+#ifdef AUDIO8_CODEC_CUDA
+        if(cuda_backend) {
+            Timer timer(timings,collect_timings,"cuda.snake_total");
+            auto ctx=cuda_graph_context();
+            auto * input=ggml_new_tensor_2d(ctx.get(),GGML_TYPE_F32,x.c,x.t);
+            auto * output=graph_snake(ctx.get(),input,name);
+            return execute_cuda_graph(ctx.get(),input,output,x);
+        }
+#endif
+        Timer timer(timings,collect_timings,"cpu.snake");
+        Tensor y=x;
+        const float * a=values(name+".alpha",x.c);
+        #pragma omp parallel for if(parallel_cpu() && x.t>256) num_threads(threads)
+        for(int t=0;t<x.t;++t) for(int c=0;c<x.c;++c) {
+            const size_t i=size_t(t)*x.c+c;
+            const float s=std::sin(a[c]*x.data[i]);
+            const float reciprocal=1.0f/(a[c]+1.0e-9f);
+            y.data[i]=x.data[i]+reciprocal*(s*s);
+        }
+        return y;
+    }
+    Tensor norm(const Tensor & x,const std::string & name,float eps,bool layer=false) {
+        Timer timer(timings,collect_timings,"cpu.norm");
+        Tensor y(x.c,x.t);
+        const float * w=values(name+".weight",x.c);
+        const float * b=layer ? values(name+".bias",x.c) : nullptr;
+        #pragma omp parallel for if(parallel_cpu() && x.t>256) num_threads(threads)
+        for(int t=0;t<x.t;++t) {
+            double mean=0,variance=0;
+            if(layer) { for(int c=0;c<x.c;++c) mean+=x.data[size_t(t)*x.c+c]; mean/=x.c; }
+            for(int c=0;c<x.c;++c) { const double d=x.data[size_t(t)*x.c+c]-mean; variance+=d*d; }
+            const float inv=1.0f/std::sqrt(float(variance/x.c)+eps);
+            for(int c=0;c<x.c;++c) y.data[size_t(t)*x.c+c]=(x.data[size_t(t)*x.c+c]-float(mean))*inv*w[c]+(b?b[c]:0.0f);
+        }
+        return y;
+    }
+    Tensor add(Tensor a,const Tensor & b) {
+        require(a.c==b.c && a.t==b.t,"codec residual shape mismatch");
+        #pragma omp parallel for if(parallel_cpu() && a.data.size()>262144) num_threads(threads)
+        for(size_t i=0;i<a.data.size();++i) a.data[i]+=b.data[i];
+        return a;
+    }
+    void scale(Tensor & x,const std::string & name) {
+        const float * s=values(name,x.c);
+        #pragma omp parallel for if(parallel_cpu() && x.t>256) num_threads(threads)
+        for(int t=0;t<x.t;++t) for(int c=0;c<x.c;++c) x.data[size_t(t)*x.c+c]*=s[c];
+    }
+    Tensor residual(const Tensor & x,const std::string & name,int dilation) {
+#ifdef AUDIO8_CODEC_CUDA
+        // Trace mode keeps individual operations so each official stage remains observable.
+        if(cuda_backend && !trace)
+            return uint64_t(x.t)*x.c*7<=uint64_t(256)*1024*1024 ?
+                cuda_residual(x,name,dilation) : cuda_residual_tiled(x,name,dilation);
+#endif
+        auto y=snake(x,name+".block.0");
+        y=conv(y,name+".block.1.conv",1,dilation);
+        y=snake(y,name+".block.2");
+        y=conv(y,name+".block.3.conv");
+        y=add(x,y); emit(name,y); return y;
+    }
+    Tensor convnext(const Tensor & x,const std::string & name) {
+        auto y=conv(x,name+".dwconv.conv",1,1,true);
+        y=norm(y,name+".norm",1.0e-6f,true);
+        y=linear(y,name+".pwconv1");
+        for(auto & v:y.data) v=0.5f*v*(1.0f+std::erf(v*0.7071067811865475244f));
+        y=linear(y,name+".pwconv2");
+        scale(y,name+".gamma"); y=add(x,y); emit(name,y); return y;
+    }
+    Tensor attention(const Tensor & x,const std::string & name,int heads,int kvheads,int window) {
+        auto qkv=linear(x,name+".wqkv");
+        require(qkv.c==(heads+2*kvheads)*64 && heads%kvheads==0,"codec attention head mismatch");
+        require(x.t<=8192,"codec position exceeds exported RoPE table");
+        const float * rope=values("audio8.codec.rope_coeffs.weight",8192*64);
+        for(int t=0;t<x.t;++t) for(int h=0;h<heads+kvheads;++h) for(int d=0;d<64;d+=2) {
+            float * pair=qkv.data.data()+size_t(t)*qkv.c+h*64+d;
+            const float even=pair[0],odd=pair[1],cs=rope[t*64+d],sn=rope[t*64+d+1];
+            pair[0]=even*cs-odd*sn; pair[1]=odd*cs+even*sn;
+        }
+        Tensor context(heads*64,x.t);
+        { Timer timer(timings,collect_timings,"cpu.attention_scores_values");
+        #pragma omp parallel for if(parallel_cpu() && x.t>256) num_threads(threads)
+        for(int t=0;t<x.t;++t) {
+          std::vector<float> scores(window);
+          for(int h=0;h<heads;++h) {
+            const int begin=std::max(0,t-window+1),n=t-begin+1,kh=h/(heads/kvheads);
+            const float * q=qkv.data.data()+size_t(t)*qkv.c+h*64;
+            float maximum=-std::numeric_limits<float>::infinity();
+            for(int s=0;s<n;++s) {
+                const float * k=qkv.data.data()+size_t(begin+s)*qkv.c+(heads+kh)*64;
+                float dot=0;
+                for(int d=0;d<64;++d) dot+=q[d]*k[d];
+                scores[s]=dot*0.125f; maximum=std::max(maximum,scores[s]);
+            }
+            float denominator=0;
+            for(int s=0;s<n;++s) { scores[s]=std::exp(scores[s]-maximum); denominator+=scores[s]; }
+            float * dst=context.data.data()+size_t(t)*context.c+h*64;
+            for(int s=0;s<n;++s) {
+                const float p=scores[s]/denominator;
+                const float * v=qkv.data.data()+size_t(begin+s)*qkv.c+(heads+kvheads+kh)*64;
+                for(int d=0;d<64;++d) dst[d]+=p*v[d];
+            }
+          }
+        }
+        }
+        auto y=linear(context,name+".wo"); emit(name,y); return y;
+    }
+    Tensor transformer(Tensor x,const std::string & name,int layers,int heads,int kvheads,int window) {
+        for(int i=0;i<layers;++i) {
+            const std::string p=name+".layers."+std::to_string(i);
+            auto a=attention(norm(x,p+".attention_norm",1.0e-5f),p+".attention",heads,kvheads,window);
+            scale(a,p+".attention_layer_scale.gamma"); x=add(x,a);
+            auto n=norm(x,p+".ffn_norm",1.0e-5f);
+            auto gate=linear(n,p+".feed_forward.w1");
+            auto up=linear(n,p+".feed_forward.w3");
+            for(size_t j=0;j<gate.data.size();++j) gate.data[j]=(gate.data[j]/(1.0f+std::exp(-gate.data[j])))*up.data[j];
+            auto ff=linear(gate,p+".feed_forward.w2");
+            scale(ff,p+".ffn_layer_scale.gamma"); x=add(x,ff); emit(p,x);
+        }
+        x=norm(x,name+".norm",1.0e-5f); emit(name,x); return x;
+    }
+    Tensor from_codes(const int32_t * codes,int frames,const std::string & name,int books,int maxcode) {
+        Tensor sum(1024,frames);
+        for(int q=0;q<books;++q) {
+            const std::string p=name+".quantizers."+std::to_string(q);
+            const float * book=values(p+".codebook.weight",size_t(maxcode)*8);
+            Tensor latent(8,frames);
+            for(int t=0;t<frames;++t) {
+                const int code=std::clamp(int(codes[size_t(q)*frames+t]),0,maxcode-1);
+                std::copy_n(book+code*8,8,latent.data.data()+size_t(t)*8);
+            }
+            // Quantizer projections are Conv1d(kernel=1), with folded weight norm.
+            auto projected=conv(latent,p+".out_proj");
+            sum=add(std::move(sum),projected);
+        }
+        emit(name,sum); return sum;
+    }
+    Tensor decode(const int32_t * codes,int frames) {
+        require(codes && frames>0 && frames<=2048,"decoder requires 1..2048 frames and ten codebook rows");
+        auto semantic=from_codes(codes,frames,"quantizer.semantic_quantizer",1,4096);
+        auto residual_codes=from_codes(codes+frames,frames,"quantizer.quantizer",9,1024);
+        auto x=add(std::move(semantic),residual_codes); emit("quantizer.latent",x);
+        x=transformer(std::move(x),"quantizer.post_module",8,16,8,128);
+        for(int i=0;i<2;++i) {
+            const std::string p="quantizer.upsample."+std::to_string(i);
+            x=transpose_conv(x,p+".0.conv",2); x=convnext(x,p+".1"); emit(p,x);
+        }
+        emit("quantizer.decode",x);
+        x=conv(x,"decoder.model.0.conv");
+        const int strides[]={8,8,4,2};
+        for(int i=0;i<4;++i) {
+            const std::string p="decoder.model."+std::to_string(i+1);
+            x=snake(x,p+".block.0");
+            x=transpose_conv(x,p+".block.1.conv",strides[i]);
+            x=residual(x,p+".block.2",1); x=residual(x,p+".block.3",3); x=residual(x,p+".block.4",9); emit(p,x);
+        }
+        x=snake(x,"decoder.model.5"); x=conv(x,"decoder.model.6.conv");
+        for(auto & v:x.data) v=std::tanh(v);
+        emit("decoder",x); require(x.c==1 && x.t==frames*2048,"decoder output length mismatch"); return x;
+    }
+    std::pair<Tensor,std::vector<int32_t>> quantize(const Tensor & x,const std::string & name,int books,int codebook_size) {
+        Tensor residual=x,sum(x.c,x.t);
+        std::vector<int32_t> codes(size_t(books)*x.t);
+        for(int q=0;q<books;++q) {
+            const std::string p=name+".quantizers."+std::to_string(q);
+            auto projected=conv(residual,p+".in_proj");
+            Tensor normalized=projected;
+            const float * rawbook=values(p+".codebook.weight",size_t(codebook_size)*8);
+            std::vector<float> book(size_t(codebook_size)*8),book_norm(codebook_size);
+            for(int r=0;r<codebook_size;++r) {
+                float squared=0; for(int c=0;c<8;++c) squared+=rawbook[r*8+c]*rawbook[r*8+c];
+                const float inv=1.0f/std::max(std::sqrt(squared),1.0e-12f);
+                float sumsq=0; for(int c=0;c<8;++c) { book[r*8+c]=rawbook[r*8+c]*inv; sumsq+=book[r*8+c]*book[r*8+c]; }
+                book_norm[r]=sumsq;
+            }
+            for(int t=0;t<x.t;++t) {
+                float squared=0; for(int c=0;c<8;++c) squared+=normalized.data[t*8+c]*normalized.data[t*8+c];
+                const float inv=1.0f/std::max(std::sqrt(squared),1.0e-12f);
+                for(int c=0;c<8;++c) normalized.data[t*8+c]*=inv;
+            }
+            auto similarities=matmul(book.data(),codebook_size,8,normalized,false);
+            Tensor selected(8,x.t);
+            for(int t=0;t<x.t;++t) {
+                float input_norm=0; for(int c=0;c<8;++c) input_norm+=normalized.data[t*8+c]*normalized.data[t*8+c];
+                int best=0; float best_distance=std::numeric_limits<float>::infinity();
+                for(int r=0;r<codebook_size;++r) {
+                    const float distance=input_norm-2.0f*similarities.data[size_t(t)*codebook_size+r]+book_norm[r];
+                    if(distance<best_distance) { best_distance=distance; best=r; }
+                }
+                codes[size_t(q)*x.t+t]=best;
+                std::copy_n(rawbook+best*8,8,selected.data.data()+t*8);
+            }
+            // The official inference code still evaluates the straight-through
+            // expression. Preserve its two FP32 rounding steps, not just its algebra.
+            for(size_t i=0;i<selected.data.size();++i)
+                selected.data[i]=projected.data[i]+(selected.data[i]-projected.data[i]);
+            auto decoded=conv(selected,p+".out_proj");
+            sum=add(std::move(sum),decoded);
+            for(size_t i=0;i<residual.data.size();++i) residual.data[i]-=decoded.data[i];
+        }
+        emit(name,sum); return {std::move(sum),std::move(codes)};
+    }
+    CodecCodes encode(const float * pcm,int samples) {
+        require(pcm && samples>0 && samples<=2048*2048,"encoder requires 1..4194304 mono samples");
+        const int frames=(samples+2047)/2048;
+        Tensor x(1,frames*2048);
+        for(int i=0;i<samples;++i) { require(std::isfinite(pcm[i]),"nonfinite PCM input"); x.data[i]=pcm[i]; }
+        x=conv(x,"encoder.block.0.conv");
+        const int strides[]={2,4,8,8};
+        for(int i=0;i<4;++i) {
+            const std::string p="encoder.block."+std::to_string(i+1)+".block";
+            x=residual(x,p+".0",1); x=residual(x,p+".1",3); x=residual(x,p+".2",9);
+            x=snake(x,p+".3"); x=conv(x,p+".4.conv",strides[i]);
+            if(i==3) x=transformer(std::move(x),p+".5",4,16,16,512);
+            emit("encoder.block."+std::to_string(i+1),x);
+        }
+        x=snake(x,"encoder.block.5"); x=conv(x,"encoder.block.6.conv"); emit("encoder",x);
+        for(int i=0;i<2;++i) {
+            const std::string p="quantizer.downsample."+std::to_string(i);
+            x=conv(x,p+".0.conv",2); x=convnext(x,p+".1"); emit(p,x);
+        }
+        x=transformer(std::move(x),"quantizer.pre_module",8,16,16,128);
+        auto semantic=quantize(x,"quantizer.semantic_quantizer",1,4096);
+        for(size_t i=0;i<x.data.size();++i) x.data[i]-=semantic.first.data[i];
+        auto residual_codes=quantize(x,"quantizer.quantizer",9,1024);
+        CodecCodes result; result.frames=x.t; result.values=std::move(semantic.second);
+        result.values.insert(result.values.end(),residual_codes.second.begin(),residual_codes.second.end());
+        require(result.frames==frames,"encoder code frame count mismatch"); return result;
+    }
+};
+
+Codec::Codec(const std::string & path,int threads) : Codec(path,CodecOptions{threads,CodecBackend::CPU,0}) {}
+Codec::Codec(const std::string & path,const CodecOptions & options) : impl(new Impl(path,options)) {}
+Codec::~Codec()=default;
+std::vector<float> Codec::decode(const int32_t * codes,int frames,CodecTrace trace) {
+    impl->timings.clear(); impl->trace=std::move(trace); auto out=impl->decode(codes,frames); impl->trace={}; return std::move(out.data);
+}
+CodecCodes Codec::encode(const float * pcm,int samples,CodecTrace trace) {
+    impl->timings.clear(); impl->trace=std::move(trace); auto out=impl->encode(pcm,samples); impl->trace={}; return out;
+}
+std::vector<CodecTiming> Codec::timings() const {
+    std::vector<CodecTiming> out;
+    for(const auto & e:impl->timings) out.push_back({e.first,e.second.first,e.second.second});
+    std::sort(out.begin(),out.end(),[](const CodecTiming & a,const CodecTiming & b){return a.name<b.name;});
+    return out;
+}
+
+void CodecPostAccess::validate_stream_backend(const Codec & codec) {
+    require(bool(codec.impl),"post stream requires a live codec");
+#ifdef AUDIO8_CODEC_CUDA
+    // Existing Impl constructor enforces NVIDIA_TF32_OVERRIDE=0 and default F32 cuBLAS.
+    // This v7 path deliberately keeps KV/attention/history on host.
+#endif
+    codec.impl->values("audio8.codec.rope_coeffs.weight",8192*64);
+}
+CodecPostTensor CodecPostAccess::from_codes(Codec & codec,const int32_t * codes,int frames) {
+    require(codes && frames>0 && frames<=2048,"post RVQ requires 1..2048 frames");
+    auto semantic=codec.impl->from_codes(codes,frames,"quantizer.semantic_quantizer",1,4096);
+    auto residual=codec.impl->from_codes(codes+frames,frames,"quantizer.quantizer",9,1024);
+    return codec.impl->add(std::move(semantic),residual);
+}
+CodecPostTensor CodecPostAccess::norm(Codec & codec,const CodecPostTensor & x,const std::string & name) {
+    return codec.impl->norm(x,name,1.0e-5f);
+}
+CodecPostTensor CodecPostAccess::linear(Codec & codec,const CodecPostTensor & x,const std::string & name) {
+    return codec.impl->linear(x,name);
+}
+const float * CodecPostAccess::values(const Codec & codec,const std::string & name,size_t count) {
+    return codec.impl->values(name,count);
+}
+CodecPostTensor CodecPostAccess::offline_post(Codec & codec,const int32_t * codes,int frames,CodecTrace trace) {
+    validate_stream_backend(codec);
+    auto prior=std::move(codec.impl->trace);
+    codec.impl->trace=std::move(trace);
+    try {
+        auto x=from_codes(codec,codes,frames);
+        codec.impl->emit("quantizer.latent",x);
+        auto result=codec.impl->transformer(std::move(x),"quantizer.post_module",8,16,8,128);
+        codec.impl->trace=std::move(prior);
+        return result;
+    } catch (...) { codec.impl->trace=std::move(prior); throw; }
+}
+
+CodecPostTensor CodecDecoderAccess::conv(Codec & codec,const CodecPostTensor & x,const std::string & name) {
+    return codec.impl->conv(x,name);
+}
+CodecPostTensor CodecDecoderAccess::convnext(Codec & codec,const CodecPostTensor & x,const std::string & name) {
+    return codec.impl->convnext(x,name);
+}
+CodecPostTensor CodecDecoderAccess::residual(Codec & codec,const CodecPostTensor & x,const std::string & name,int dilation) {
+    return codec.impl->residual(x,name,dilation);
+}
+CodecPostTensor CodecDecoderAccess::snake(Codec & codec,const CodecPostTensor & x,const std::string & name) {
+    return codec.impl->snake(x,name);
+}
+CodecPostTensor CodecDecoderAccess::transpose(Codec & codec,const CodecPostTensor & x,const std::string & name,int stride) {
+    auto * w=codec.impl->weight(name+".weight");
+    require(w->ne[0]==stride,"stateless stream transpose requires kernel==stride");
+    return codec.impl->transpose_conv(x,name,stride);
+}
+std::vector<float> CodecDecoderAccess::bias(Codec & codec,const std::string & name,size_t channels) {
+    std::vector<float> result(channels,0);
+    if(ggml_get_tensor(codec.impl->weights,(name+".bias").c_str())) {
+        const float * values=codec.impl->values(name+".bias",channels);
+        std::copy_n(values,channels,result.data());
+    }
+    return result;
+}
+CodecPostTensor CodecDecoderAccess::transpose_raw(Codec & codec,const CodecPostTensor & x,const std::string & name,int stride) {
+    // v7 hybrid raw pre-bias counterpart of Impl::transpose_conv. The original
+    // offline function is untouched. Reuses its reordered weights and matmul;
+    // only the output extent is enlarged by kernel-stride, with no bias/crop.
+    // CUDA uses existing F32 matmul; host overlap/pending remain explicit.
+    auto & impl=*codec.impl;
+#ifdef AUDIO8_CODEC_CUDA
+    // v7 uses the existing strict-F32 CUDA matmul when available; overlap stays CPU.
+#endif
+    auto * w=impl.weight(name+".weight");
+    const int k=int(w->ne[0]),cout=int(w->ne[1]),cin=int(w->ne[2]);
+    require(cin==x.c&&stride>0&&k==2*stride&&k<=32&&w->ne[3]==1,"invalid raw stream transpose shape");
+    auto it=impl.transposed_weights.find(name);
+    if(it==impl.transposed_weights.end()) {
+        std::vector<float> reordered(size_t(cin)*cout*k);
+        const float * raw=static_cast<float *>(w->data);
+        for(int ci=0;ci<cin;++ci)for(int co=0;co<cout;++co)for(int j=0;j<k;++j)
+            reordered[(size_t(co)*k+j)*cin+ci]=raw[(size_t(ci)*cout+co)*k+j];
+        it=impl.transposed_weights.emplace(name,std::move(reordered)).first;
+    }
+    require(x.t>0&&x.t<=(std::numeric_limits<int>::max()-(k-stride))/stride,"raw transpose rows overflow");
+    Tensor y(cout,x.t*stride+k-stride);
+    const int chunk=impl.convolution_chunk();
+    for(int start=0;start<x.t;start+=chunk) {
+        const int count=std::min(chunk,x.t-start);
+        Tensor input(cin,count);
+        std::copy_n(x.data.data()+size_t(start)*cin,input.data.size(),input.data.data());
+        auto projected=impl.matmul(it->second.data(),cout*k,cin,input);
+        for(int co=0;co<cout;++co)for(int t=0;t<count;++t)for(int j=0;j<k;++j) {
+            const int ti=(start+t)*stride+j;
+            y.data[size_t(ti)*cout+co]+=projected.data[size_t(t)*(cout*k)+co*k+j];
+        }
+    }
+    return y;
+}
+}
diff --git a/tools/audio8/audio8-codec-native.h b/tools/audio8/audio8-codec-native.h
new file mode 100644
