+#pragma once
+#include "audio8-codec-post-stream.h"
+#include "audio8-codec-stream-state.h"
+
+namespace audio8 {
+class CodecDecoderAccess {
+private:
+    friend class CodecDecoderStream;
+    static CodecPostTensor conv(Codec &, const CodecPostTensor &, const std::string &);
+    static CodecPostTensor convnext(Codec &, const CodecPostTensor &, const std::string &);
+    static CodecPostTensor residual(Codec &, const CodecPostTensor &, const std::string &, int dilation);
+    static CodecPostTensor snake(Codec &, const CodecPostTensor &, const std::string &);
+    static CodecPostTensor transpose(Codec &, const CodecPostTensor &, const std::string &, int stride);
+    static CodecPostTensor transpose_raw(Codec &, const CodecPostTensor &, const std::string &, int stride);
+    static std::vector<float> bias(Codec &, const std::string &, size_t channels);
+};
+class CodecDecoderCancelled : public std::runtime_error {
+public: CodecDecoderCancelled() : std::runtime_error("codec decoder stream cancelled") {}
+};
+struct CodecDecoderChunk {
+    int frame_offset=0;
+    uint64_t sample_offset=0;
+    std::vector<float> pcm; // mono 44100, exactly 2048*new_frames samples
+};
+// Experimental CPU/CUDA hybrid full decoder stream. Codec outlives stream; single caller,
+// no callback re-entry; model is fixed F32 and not mutated. Host KV/history/pending.
+// No TTS/HTTP integration in this standalone experiment.
+class CodecDecoderStream {
+public:
+    using Cancel=std::function<bool()>;
+    explicit CodecDecoderStream(Codec & codec);
+    ~CodecDecoderStream();
+    CodecDecoderStream(const CodecDecoderStream &)=delete;
+    CodecDecoderStream & operator=(const CodecDecoderStream &)=delete;
+    CodecDecoderChunk push(const std::vector<int32_t> & codes,int frames,CodecTrace trace={},Cancel cancel={});
+    void reset();
+    void finish(); // no additional PCM; drops final transpose tails
+    void abort() noexcept;
+    StreamStateStatus status() const noexcept;
+    int position() const noexcept;
+    size_t state_bytes() const noexcept;
+private:
+    struct Impl;
+    std::unique_ptr<Impl> impl;
+};
+}
