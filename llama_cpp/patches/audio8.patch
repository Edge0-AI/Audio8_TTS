+++ b/tools/audio8/audio8-codec-native.h
@@ -0,0 +1,43 @@
+#pragma once
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <string>
+#include <vector>
+
+// Independent CPU/GGML baseline with optional CUDA F32 GEMM acceleration.
+// Public arrays: codes [codebook, frame], PCM mono 44100 Hz. Trace tensors are
+// [time, channel] contiguous F32. No AR/libllama state is owned by this module.
+namespace audio8 {
+struct CodecCodes {
+    int frames = 0;
+    std::vector<int32_t> values; // ten rows, each containing `frames` entries
+};
+using CodecTrace = std::function<void(const std::string &, const float *, int, int)>;
+enum class CodecBackend { CPU, CUDA };
+struct CodecOptions {
+    int threads = 4;
+    CodecBackend backend = CodecBackend::CPU;
+    int device = 0; // logical device after CUDA_VISIBLE_DEVICES filtering
+    bool collect_timings = false;
+};
+struct CodecTiming { std::string name; double seconds; uint64_t calls; };
+class Codec {
+public:
+    explicit Codec(const std::string & gguf_path, int threads = 4);
+    Codec(const std::string & gguf_path, const CodecOptions & options);
+    ~Codec();
+    Codec(const Codec &) = delete;
+    Codec & operator=(const Codec &) = delete;
+    std::vector<float> decode(const int32_t * codes, int frames, CodecTrace trace = {});
+    CodecCodes encode(const float * pcm, int samples, CodecTrace trace = {});
+    std::vector<CodecTiming> timings() const; // last encode/decode, nested categories overlap
+    static constexpr int sample_rate = 44100;
+    static constexpr int frame_length = 2048;
+private:
+    friend class CodecPostAccess;
+    friend class CodecDecoderAccess;
+    struct Impl;
+    std::unique_ptr<Impl> impl;
+};
+}
diff --git a/tools/audio8/audio8-codec-post-stream.cpp b/tools/audio8/audio8-codec-post-stream.cpp
new file mode 100644
index 0000000..91fe13f
--- /dev/null
+++ b/tools/audio8/audio8-codec-post-stream.cpp
@@ -0,0 +1,147 @@
+#include "audio8-codec-post-stream.h"
+#include <algorithm>
+#include <cmath>
+#include <limits>
+
+namespace audio8 {
+namespace {
+constexpr int channels = 1024, kv_width = 512, head_dim = 64;
+constexpr int heads = 16, kv_heads = 8, window = 128;
+void check(bool condition, const char * message) {
+    if (!condition) throw std::runtime_error(message);
+}
+void finite(const CodecPostTensor & x) {
+    check(x.c > 0 && x.t > 0 && x.data.size() == size_t(x.c)*x.t, "post tensor shape mismatch");
+    for (float v : x.data) check(std::isfinite(v), "nonfinite codec post activation");
+}
+void emit(const CodecTrace & trace, const std::string & name, const CodecPostTensor & x) {
+    finite(x);
+    if (trace) trace(name, x.data.data(), x.t, x.c);
+}
+}
+void CodecPostStream::scaled_add(CodecPostTensor & x, const CodecPostTensor & y, const std::string & name) {
+    check(x.c == y.c && x.t == y.t, "post residual shape mismatch");
+    const float * scale = CodecPostAccess::values(codec_, name, size_t(x.c));
+    for (int t=0; t<x.t; ++t) for (int c=0; c<x.c; ++c) {
+        const size_t at=size_t(t)*x.c+c;
+        const float scaled=y.data[at]*scale[c]; // match original scale, then add; FMA disabled
+        x.data[at] += scaled;
+    }
+}
+CodecPostStream::CodecPostStream(Codec & codec) : codec_(codec) {
+    CodecPostAccess::validate_stream_backend(codec_);
+}
+void CodecPostStream::discard() noexcept {
+    for (auto & layer : layers_) { std::vector<float>().swap(layer.k); std::vector<float>().swap(layer.v); }
+}
+void CodecPostStream::reset() {
+    discard(); position_=0; status_=CodecPostStatus::active;
+}
+void CodecPostStream::abort() noexcept { discard(); status_=CodecPostStatus::aborted; }
+void CodecPostStream::finish() {
+    if (status_ == CodecPostStatus::finished) return;
+    check(status_ == CodecPostStatus::active, "cannot finish an aborted or failed post stream");
+    discard(); status_=CodecPostStatus::finished;
+}
+size_t CodecPostStream::cached_rows(int layer) const {
+    check(layer>=0 && layer<int(layers_.size()), "invalid post cache layer");
+    return layers_[size_t(layer)].k.size()/kv_width;
+}
+size_t CodecPostStream::state_bytes() const noexcept {
+    size_t bytes=0;
+    for (const auto & layer : layers_) bytes+=(layer.k.size()+layer.v.size())*sizeof(float);
+    return bytes;
+}
+void CodecPostStream::poll(const Cancel & cancel) {
+    if (cancel && cancel()) { abort(); throw CodecPostCancelled(); }
+}
+CodecPostTensor CodecPostStream::attention(const CodecPostTensor & x, const std::string & name,
+                                          LayerCache & cache, const Cancel & cancel) {
+    auto qkv=CodecPostAccess::linear(codec_,x,name+".wqkv");
+    check(qkv.c==(heads+2*kv_heads)*head_dim && qkv.t==x.t, "post QKV shape mismatch");
+    const float * rope=CodecPostAccess::values(codec_,"audio8.codec.rope_coeffs.weight",8192*64);
+    for (int t=0; t<x.t; ++t) for (int h=0; h<heads+kv_heads; ++h) for (int d=0; d<head_dim; d+=2) {
+        float * pair=qkv.data.data()+size_t(t)*qkv.c+h*head_dim+d;
+        const float even=pair[0], odd=pair[1], cs=rope[size_t(position_+t)*64+d], sn=rope[size_t(position_+t)*64+d+1];
+        pair[0]=even*cs-odd*sn; pair[1]=odd*cs+even*sn;
+    }
+    const int old=int(cache.k.size()/kv_width);
+    check(old==std::min(position_,window-1) && cache.v.size()==cache.k.size(), "post KV state/position mismatch");
+    // Keep old rows plus ALL new rows until every query has consumed its window.
+    std::vector<float> joined_k(size_t(old+x.t)*kv_width), joined_v(joined_k.size());
+    std::copy(cache.k.begin(),cache.k.end(),joined_k.begin());
+    std::copy(cache.v.begin(),cache.v.end(),joined_v.begin());
+    for (int t=0; t<x.t; ++t) {
+        const float * row=qkv.data.data()+size_t(t)*qkv.c;
+        std::copy_n(row+heads*head_dim,kv_width,joined_k.data()+size_t(old+t)*kv_width);
+        std::copy_n(row+(heads+kv_heads)*head_dim,kv_width,joined_v.data()+size_t(old+t)*kv_width);
+    }
+    CodecPostTensor context(channels,x.t);
+    std::array<float,window> scores{};
+    for (int t=0; t<x.t; ++t) {
+        poll(cancel);
+        const int end=old+t, begin=std::max(0,end-window+1), n=end-begin+1;
+        for (int h=0; h<heads; ++h) {
+            const int kh=h/(heads/kv_heads);
+            const float * q=qkv.data.data()+size_t(t)*qkv.c+h*head_dim;
+            float maximum=-std::numeric_limits<float>::infinity();
+            for (int s=0; s<n; ++s) {
+                const float * k=joined_k.data()+size_t(begin+s)*kv_width+kh*head_dim;
+                float dot=0;
+                for (int d=0; d<head_dim; ++d) dot+=q[d]*k[d];
+                scores[size_t(s)]=dot*0.125f; maximum=std::max(maximum,scores[size_t(s)]);
+            }
+            float denominator=0;
+            for (int s=0; s<n; ++s) { scores[size_t(s)]=std::exp(scores[size_t(s)]-maximum); denominator+=scores[size_t(s)]; }
+            float * dst=context.data.data()+size_t(t)*channels+h*head_dim;
+            for (int s=0; s<n; ++s) {
+                const float p=scores[size_t(s)]/denominator;
+                const float * v=joined_v.data()+size_t(begin+s)*kv_width+kh*head_dim;
+                for (int d=0; d<head_dim; ++d) dst[d]+=p*v[d];
+            }
+        }
+    }
+    auto y=CodecPostAccess::linear(codec_,context,name+".wo");
+    const size_t keep=size_t(std::min(old+x.t,window-1))*kv_width;
+    cache.k.assign(joined_k.end()-keep,joined_k.end());
+    cache.v.assign(joined_v.end()-keep,joined_v.end());
+    return y;
+}
+CodecPostChunk CodecPostStream::push(const std::vector<int32_t> & codes, int frames, CodecTrace trace, Cancel cancel) {
+    // Rejected arguments have no state effects. A computation/callback failure
+    // after this point poisons the entire stream rather than promising rollback.
+    check(status_==CodecPostStatus::active,"codec post stream is not active");
+    check(frames>0 && frames<=2048-position_,"post push needs positive frames within cumulative 2048 limit");
+    check(codes.size()==size_t(10)*frames,"post push requires ten complete codebook rows");
+    try {
+        poll(cancel);
+        auto x=CodecPostAccess::from_codes(codec_,codes.data(),frames);
+        emit(trace,"quantizer.latent",x);
+        for (int i=0; i<8; ++i) {
+            poll(cancel);
+            const std::string p="quantizer.post_module.layers."+std::to_string(i);
+            auto a=attention(CodecPostAccess::norm(codec_,x,p+".attention_norm"),p+".attention",layers_[size_t(i)],cancel);
+            emit(trace,p+".attention",a);
+            scaled_add(x,a,p+".attention_layer_scale.gamma");
+            auto n=CodecPostAccess::norm(codec_,x,p+".ffn_norm");
+            auto gate=CodecPostAccess::linear(codec_,n,p+".feed_forward.w1");
+            auto up=CodecPostAccess::linear(codec_,n,p+".feed_forward.w3");
+            check(gate.c==up.c && gate.t==up.t,"post FFN shape mismatch");
+            for (size_t j=0; j<gate.data.size(); ++j) gate.data[j]=(gate.data[j]/(1.0f+std::exp(-gate.data[j])))*up.data[j];
+            auto ff=CodecPostAccess::linear(codec_,gate,p+".feed_forward.w2");
+            scaled_add(x,ff,p+".ffn_layer_scale.gamma");
+            emit(trace,p,x);
+        }
+        x=CodecPostAccess::norm(codec_,x,"quantizer.post_module.norm");
+        emit(trace,"quantizer.post_module",x);
+        poll(cancel); // no activation is returned after cancellation
+        CodecPostChunk result{position_,std::move(x)};
+        position_+=frames;
+        return result;
+    } catch (const CodecPostCancelled &) {
+        abort(); throw;
+    } catch (...) {
+        discard(); status_=CodecPostStatus::failed; throw;
+    }
+}
+}
diff --git a/tools/audio8/audio8-codec-post-stream.h b/tools/audio8/audio8-codec-post-stream.h
new file mode 100644
index 0000000..6208cfd
--- /dev/null
+++ b/tools/audio8/audio8-codec-post-stream.h
@@ -0,0 +1,73 @@
+#pragma once
+#include "audio8-codec-native.h"
+#include <array>
+#include <cstddef>
+#include <stdexcept>
+
+namespace audio8 {
+// Internal experimental bridge, not a stable public codec ABI. Channel-fast F32.
+struct CodecPostTensor {
+    int c = 0, t = 0;
+    std::vector<float> data;
+    CodecPostTensor() = default;
+    CodecPostTensor(int channels, int times) : c(channels), t(times) {
+        if (channels <= 0 || times <= 0) throw std::runtime_error("invalid codec tensor dimensions");
+        data.resize(size_t(channels) * times);
+    }
+};
+
+// Implemented only in source-v5-stream/native.cpp. Reuses the original GGUF,
+// RVQ, norm and linear code without loading or copying a second set of weights.
+class CodecPostAccess {
+public:
+    static CodecPostTensor offline_post(Codec & codec, const int32_t * codes, int frames, CodecTrace trace = {});
+private:
+    friend class CodecPostStream;
+    static void validate_stream_backend(const Codec & codec);
+    static CodecPostTensor from_codes(Codec & codec, const int32_t * codes, int frames);
+    static CodecPostTensor norm(Codec & codec, const CodecPostTensor & x, const std::string & name);
+    static CodecPostTensor linear(Codec & codec, const CodecPostTensor & x, const std::string & name);
+    static const float * values(const Codec & codec, const std::string & name, size_t count);
+};
+
+enum class CodecPostStatus { active, finished, aborted, failed };
+class CodecPostCancelled : public std::runtime_error {
+public:
+    CodecPostCancelled() : std::runtime_error("codec post stream cancelled") {}
+};
+struct CodecPostChunk {
+    int frame_offset = 0;
+    CodecPostTensor activation; // only new [frames, 1024] post final RMSNorm rows
+};
+
+// v7 CPU/CUDA hybrid slice: KV/attention remain host. Codec outlives this object. No concurrent codec
+// calls, streams, callbacks that re-enter this object, or shared weight mutation.
+// A callback exception poisons the stream; reset creates fresh request state.
+class CodecPostStream {
+public:
+    using Cancel = std::function<bool()>;
+    explicit CodecPostStream(Codec & codec);
+    CodecPostStream(const CodecPostStream &) = delete;
+    CodecPostStream & operator=(const CodecPostStream &) = delete;
+    CodecPostChunk push(const std::vector<int32_t> & codes, int frames,
+                        CodecTrace trace = {}, Cancel cancel = {});
+    void reset();
+    void finish(); // active -> finished; repeating finish is idempotent
+    void abort() noexcept; // discards cache; idempotent
+    CodecPostStatus status() const noexcept { return status_; }
+    int position() const noexcept { return position_; }
+    size_t cached_rows(int layer) const;
+    size_t state_bytes() const noexcept;
+private:
+    struct LayerCache { std::vector<float> k, v; };
+    Codec & codec_;
+    std::array<LayerCache, 8> layers_;
+    int position_ = 0;
+    CodecPostStatus status_ = CodecPostStatus::active;
+    void discard() noexcept;
+    void poll(const Cancel & cancel);
+    void scaled_add(CodecPostTensor & x, const CodecPostTensor & y, const std::string & name);
+    CodecPostTensor attention(const CodecPostTensor & x, const std::string & name,
+                              LayerCache & cache, const Cancel & cancel);
+};
+}
diff --git a/tools/audio8/audio8-codec-stream-state.cpp b/tools/audio8/audio8-codec-stream-state.cpp
new file mode 100644
index 0000000..7080060
--- /dev/null
+++ b/tools/audio8/audio8-codec-stream-state.cpp
@@ -0,0 +1,123 @@
+#include "audio8-codec-stream-state.h"
+#include <algorithm>
+#include <cmath>
+#include <utility>
+
+namespace audio8 {
+namespace {
+size_t mul(size_t a, size_t b) {
+    if (b && a>std::numeric_limits<size_t>::max()/b) throw std::overflow_error("codec state size multiplication overflow");
+    return a*b;
+}
+size_t add(size_t a, size_t b) {
+    if (a>std::numeric_limits<size_t>::max()-b) throw std::overflow_error("codec state row addition overflow");
+    return a+b;
+}
+size_t count(size_t rows, size_t channels) {
+    const size_t n=mul(rows,channels);
+    if (n>std::vector<float>().max_size()) throw std::length_error("codec state exceeds vector max_size");
+    (void)mul(n,sizeof(float)); return n;
+}
+void active(StreamStateStatus status) {
+    if (status!=StreamStateStatus::active) throw std::logic_error("codec state is not active");
+}
+uint64_t advance(uint64_t position, size_t rows, uint64_t limit) {
+    if (!rows) throw std::invalid_argument("codec state input must have positive rows");
+    if (rows>limit-position) throw std::overflow_error("codec state cumulative input limit exceeded");
+    return position+rows;
+}
+void finite_input(const std::vector<float> & input) {
+    for (float v:input) if (!std::isfinite(v)) throw std::invalid_argument("nonfinite codec state input");
+}
+void release(std::vector<float> & v) noexcept { std::vector<float>().swap(v); }
+}
+CausalHistory::CausalHistory(size_t channels,size_t history_rows,uint64_t max_input_rows)
+    : channels_(channels),history_rows_(history_rows),limit_(max_input_rows) {
+    if (!channels_ || !limit_) throw std::invalid_argument("channels and cumulative limit must be positive");
+    history_.resize(count(history_rows_,channels_),0.0f);
+}
+void CausalHistory::fail() noexcept { release(history_);status_=StreamStateStatus::failed; }
+void CausalHistory::abort() noexcept { release(history_);status_=StreamStateStatus::aborted; }
+void CausalHistory::reset() {
+    try { std::vector<float> fresh(count(history_rows_,channels_),0.0f);history_.swap(fresh);position_=0;status_=StreamStateStatus::active; }
+    catch (...) { fail();throw; }
+}
+void CausalHistory::finish() {
+    if (status_==StreamStateStatus::finished) return;
+    active(status_);release(history_);status_=StreamStateStatus::finished;
+}
+void CausalHistory::poll(const StreamStateCancel & cancel) {
+    if (cancel && cancel()) { abort();throw StreamStateCancelled(); }
+}
+CausalWindow CausalHistory::push(const std::vector<float> & input,size_t rows,StreamStateCancel cancel) {
+    active(status_);
+    const uint64_t next=advance(position_,rows,limit_);
+    const size_t n=count(rows,channels_),window_rows=add(history_rows_,rows),window_count=count(window_rows,channels_);
+    if (input.size()!=n) throw std::invalid_argument("causal history input shape mismatch");
+    finite_input(input); // invalid parameters leave state unchanged
+    try {
+        poll(cancel);
+        CausalWindow out;
+        out.rows=window_rows;out.channels=channels_;out.prefix_rows=history_rows_;out.input_offset=position_;
+        out.data.reserve(window_count);
+        out.data.insert(out.data.end(),history_.begin(),history_.end());
+        out.data.insert(out.data.end(),input.begin(),input.end());
+        std::vector<float> next_history(out.data.end()-history_.size(),out.data.end());
+        poll(cancel); // no result/state commit after cancellation
+        history_.swap(next_history);position_=next;
+        return out;
+    } catch (const StreamStateCancelled &) { abort();throw; }
+      catch (...) { fail();throw; }
+}
+TransposeOverlap::TransposeOverlap(size_t channels,size_t kernel,size_t stride,uint64_t max_input_rows)
+    : channels_(channels),stride_(stride),tail_rows_(0),limit_(max_input_rows) {
+    if (!channels_ || !stride_ || !limit_ || kernel<stride_)
+        throw std::invalid_argument("invalid transpose overlap dimensions");
+    // Subtraction avoids overflowing 2*stride for malformed dimensions.
+    if (kernel!=stride_ && kernel-stride_!=stride_)
+        throw std::invalid_argument("only transpose kernel=stride or 2*stride is supported");
+    tail_rows_=kernel-stride_;
+    pending_.resize(count(tail_rows_,channels_),0.0f);
+}
+void TransposeOverlap::fail() noexcept { release(pending_);status_=StreamStateStatus::failed; }
+void TransposeOverlap::abort() noexcept { release(pending_);status_=StreamStateStatus::aborted; }
+void TransposeOverlap::reset() {
+    try { std::vector<float> fresh(count(tail_rows_,channels_),0.0f);pending_.swap(fresh);input_position_=0;output_position_=0;status_=StreamStateStatus::active; }
+    catch (...) { fail();throw; }
+}
+void TransposeOverlap::finish() {
+    if (status_==StreamStateStatus::finished) return;
+    active(status_);release(pending_);status_=StreamStateStatus::finished;
+}
+void TransposeOverlap::poll(const StreamStateCancel & cancel) {
+    if (cancel && cancel()) { abort();throw StreamStateCancelled(); }
+}
+TransposeChunk TransposeOverlap::merge(const std::vector<float> & raw,size_t input_rows,
+                                       const std::vector<float> & bias,StreamStateCancel cancel) {
+    active(status_);
+    const uint64_t next_input=advance(input_position_,input_rows,limit_);
+    if (next_input>std::numeric_limits<uint64_t>::max()/stride_)
+        throw std::overflow_error("transpose cumulative output position overflow");
+    const uint64_t next_output=next_input*stride_;
+    const size_t emit_rows=mul(input_rows,stride_),raw_rows=add(emit_rows,tail_rows_);
+    const size_t emit_count=count(emit_rows,channels_),raw_count=count(raw_rows,channels_);
+    if (raw.size()!=raw_count || bias.size()!=channels_) throw std::invalid_argument("transpose raw/bias shape mismatch");
+    finite_input(raw);finite_input(bias);
+    try {
+        poll(cancel);
+        TransposeChunk out;
+        out.rows=emit_rows;out.channels=channels_;out.input_offset=input_position_;out.output_offset=output_position_;
+        out.data.assign(raw.begin(),raw.begin()+emit_count);
+        for (size_t i=0;i<pending_.size();++i) out.data[i]+=pending_[i];
+        for (size_t t=0;t<emit_rows;++t) for (size_t c=0;c<channels_;++c) {
+            float & value=out.data[t*channels_+c];value+=bias[c];
+            if (!std::isfinite(value)) throw std::runtime_error("nonfinite transpose overlap result");
+        }
+        std::vector<float> next_pending(raw.begin()+emit_count,raw.end());
+        poll(cancel);
+        pending_.swap(next_pending);input_position_=next_input;output_position_=next_output;
+        return out;
+    } catch (const StreamStateCancelled &) { abort();throw; }
+      catch (...) { fail();throw; }
+}
+}
diff --git a/tools/audio8/audio8-codec-stream-state.h b/tools/audio8/audio8-codec-stream-state.h
new file mode 100644
index 0000000..5b925fa
--- /dev/null
+++ b/tools/audio8/audio8-codec-stream-state.h
@@ -0,0 +1,78 @@
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <limits>
+#include <stdexcept>
+#include <vector>
+
+namespace audio8 {
+enum class StreamStateStatus { active, finished, aborted, failed };
+using StreamStateCancel = std::function<bool()>;
+class StreamStateCancelled : public std::runtime_error {
+public:
+    StreamStateCancelled() : std::runtime_error("codec stream state cancelled") {}
+};
+struct CausalWindow {
+    std::vector<float> data; // channel-fast [rows, channels], prefix then new input
+    size_t rows=0, channels=0, prefix_rows=0;
+    uint64_t input_offset=0; // absolute row of first NEW input, in this layer's scale
+};
+struct TransposeChunk {
+    std::vector<float> data; // channel-fast [rows, channels], bias already applied once
+    size_t rows=0, channels=0;
+    uint64_t input_offset=0, output_offset=0;
+};
+
+// Weight-free, single-caller state. No callback re-entry or concurrent calls.
+// Valid push commits its input history; a downstream stage failure must abort
+// the containing stream. This helper does not promise cross-layer rollback.
+class CausalHistory {
+public:
+    CausalHistory(size_t channels, size_t history_rows,
+                  uint64_t max_input_rows=std::numeric_limits<uint64_t>::max());
+    CausalWindow push(const std::vector<float> & input, size_t rows, StreamStateCancel cancel={});
+    void reset();
+    void finish(); // drops state, no samples; idempotent only after successful finish
+    void abort() noexcept; // any state -> aborted, discards storage
+    StreamStateStatus status() const noexcept { return status_; }
+    uint64_t input_position() const noexcept { return position_; }
+    size_t history_rows() const noexcept { return history_rows_; }
+    size_t channels() const noexcept { return channels_; }
+    size_t state_bytes() const noexcept { return history_.size()*sizeof(float); }
+private:
+    size_t channels_, history_rows_;
+    uint64_t limit_, position_=0;
+    StreamStateStatus status_=StreamStateStatus::active;
+    std::vector<float> history_;
+    void poll(const StreamStateCancel & cancel);
+    void fail() noexcept;
+};
+
+// Accepts full raw transpose convolution with NO bias and NO right crop.
+// Only production kernel==stride and kernel==2*stride are supported.
+// Input raw has rows*stride+(kernel-stride) rows. Pending is always pre-bias.
+class TransposeOverlap {
+public:
+    TransposeOverlap(size_t channels, size_t kernel, size_t stride,
+                     uint64_t max_input_rows=std::numeric_limits<uint64_t>::max());
+    TransposeChunk merge(const std::vector<float> & raw, size_t input_rows,
+                         const std::vector<float> & bias, StreamStateCancel cancel={});
+    void reset();
+    void finish(); // discards final right tail; emits NOTHING; repeated finish is OK
+    void abort() noexcept;
+    StreamStateStatus status() const noexcept { return status_; }
+    uint64_t input_position() const noexcept { return input_position_; }
+    uint64_t output_position() const noexcept { return output_position_; }
+    size_t pending_rows() const noexcept { return tail_rows_; }
+    size_t channels() const noexcept { return channels_; }
+    size_t state_bytes() const noexcept { return pending_.size()*sizeof(float); }
+private:
+    size_t channels_, stride_, tail_rows_;
+    uint64_t limit_, input_position_=0, output_position_=0;
+    StreamStateStatus status_=StreamStateStatus::active;
+    std::vector<float> pending_;
+    void poll(const StreamStateCancel & cancel);
+    void fail() noexcept;
+};
+}
diff --git a/tools/audio8/audio8-platform.h b/tools/audio8/audio8-platform.h
new file mode 100644
index 0000000..df620d9
--- /dev/null
+++ b/tools/audio8/audio8-platform.h
@@ -0,0 +1,75 @@
+#pragma once
+#include <stdexcept>
+#include <string>
+#include <utility>
+#include <vector>
+
+#ifdef _WIN32
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#include <shellapi.h>
+#ifdef _MSC_VER
+#pragma comment(lib, "shell32.lib")
+#endif
+#endif
+
+namespace audio8 {
+// Use at a process-command-line entry point, before interpreting paths/text.
+// Keep this object alive while argv() is used. It does not rewrite arbitrary
+// embedded argument lists: a Windows argc mismatch is an explicit error.
+// On non-Windows, argc/argv and their byte contents are returned unchanged.
+class utf8_arguments {
+public:
+    utf8_arguments(int argc, char ** argv) : argc_(argc), argv_(argv) {
+        if (argc < 0 || (argc > 0 && !argv)) {
+            throw std::invalid_argument("Invalid process arguments");
+        }
+#ifdef _WIN32
+        int wide_count = 0;
+        auto * wide = CommandLineToArgvW(GetCommandLineW(), &wide_count);
+        if (!wide) { throw std::runtime_error("Cannot read Windows Unicode command line"); }
+        struct local_free {
+            LPWSTR * value;
+            ~local_free() { LocalFree(value); }
+        } guard{wide};
+        if (wide_count != argc) {
+            throw std::invalid_argument("UTF-8 argv conversion requires the process command line");
+        }
+        storage_.reserve(size_t(wide_count));
+        for (int i = 0; i < wide_count; ++i) {
+            const int length = WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS,
+                                                   wide[i], -1, nullptr, 0, nullptr, nullptr);
+            if (length <= 0) { throw std::runtime_error("Invalid Unicode Windows argument"); }
+            std::string value(size_t(length), '\0');
+            if (WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, wide[i], -1,
+                                    value.data(), length, nullptr, nullptr) != length) {
+                throw std::runtime_error("Cannot convert Windows argument to UTF-8");
+            }
+            value.resize(size_t(length - 1));
+            storage_.push_back(std::move(value));
+        }
+        pointers_.reserve(storage_.size() + 1);
+        for (auto & value : storage_) { pointers_.push_back(value.data()); }
+        pointers_.push_back(nullptr);
+        argc_ = wide_count;
+        argv_ = pointers_.data();
+#endif
+    }
+    utf8_arguments(const utf8_arguments &) = delete;
+    utf8_arguments & operator=(const utf8_arguments &) = delete;
+    utf8_arguments(utf8_arguments &&) = delete;
+    utf8_arguments & operator=(utf8_arguments &&) = delete;
+    int argc() const { return argc_; }
+    char ** argv() const { return argv_; }
+private:
+    int argc_;
+    char ** argv_;
+    std::vector<std::string> storage_;
+    std::vector<char *> pointers_;
+};
+} // namespace audio8
diff --git a/tools/audio8/audio8-sampling.cpp b/tools/audio8/audio8-sampling.cpp
new file mode 100644
index 0000000..349088f
--- /dev/null
+++ b/tools/audio8/audio8-sampling.cpp
@@ -0,0 +1,176 @@
+#include "audio8-sampling.h"
+#include <algorithm>
+#include <cmath>
+#include <limits>
+#include <numeric>
+#include <stdexcept>
+
+namespace audio8 {
+static void require(bool value, const char * message) {
+    if (!value) { throw std::invalid_argument(message); }
+}
+static void validate_parameters(int k, float p, float temperature) {
+    require(k > 0, "top_k must be positive");
+    require(std::isfinite(p) && p > 0 && p <= 1, "top_p must be in (0,1]");
+    require(std::isfinite(temperature) && temperature > 0, "temperature must be positive and finite");
+}
+void sampling_options::validate() const {
+    validate_parameters(top_k, top_p, temperature);
+    validate_parameters(top_k, ras_top_p, ras_temperature);
+    require(ras_window_size > 0 && ras_window_size <= 2048, "RAS window must be in [1,2048]");
+}
+uniform_source::uniform_source(uint32_t seed) : engine_(seed) {}
+uniform_source::uniform_source(std::vector<float> tape) : engine_(0), tape_(std::move(tape)), replay_(true) {
+    for (float value : tape_) { require(std::isfinite(value) && value >= 0 && value < 1, "Uniforms must be in [0,1)"); }
+}
+std::vector<float> uniform_source::draw(size_t count) {
+    if (replay_) {
+        require(consumed_ <= tape_.size() && count <= tape_.size() - size_t(consumed_), "Random replay tape exhausted");
+        std::vector<float> result(tape_.begin() + size_t(consumed_), tape_.begin() + size_t(consumed_) + count);
+        consumed_ += count;
+        return result;
+    }
+    std::vector<float> result(count);
+    for (float & value : result) { value = float(engine_() >> 8) * (1.0f / 16777216.0f); }
+    consumed_ += count;
+    return result;
+}
+std::string uniform_source::algorithm() const { return replay_ ? "external_full_vocabulary_f32_uniform_tape" : "mt19937_high24_uniform_f32_v1"; }
+
+std::vector<float> score_probabilities(const std::vector<float> & scores) {
+    require(!scores.empty(), "Empty logits");
+    float maximum = -std::numeric_limits<float>::infinity();
+    for (float value : scores) {
+        require(!std::isnan(value) && value != std::numeric_limits<float>::infinity(), "NaN or positive infinity logits");
+        maximum = std::max(maximum, value);
+    }
+    require(std::isfinite(maximum), "No finite candidates");
+    std::vector<float> result(scores.size());
+    double total_accumulator = 0;
+    for (size_t i = 0; i < scores.size(); ++i) {
+        result[i] = std::exp(scores[i] - maximum);
+        total_accumulator += result[i];
+    }
+    const float total = float(total_accumulator);
+    require(std::isfinite(total) && total > 0, "Invalid softmax sum");
+    const float inverse = 1.0f / total;
+    for (float & value : result) { value *= inverse; }
+    return result;
+}
+
+filtered_distribution process_scores(const std::vector<float> & scores, int k, float p, float temperature) {
+    validate_parameters(k, p, temperature);
+    require(!scores.empty(), "Empty logits");
+    std::vector<int> order;
+    order.reserve(scores.size());
+    for (size_t id=0;id<scores.size();++id) {
+        const float score=scores[id];
+        require(!std::isnan(score) && score != std::numeric_limits<float>::infinity(), "NaN or positive infinity logits");
+        if(std::isfinite(score)) { order.push_back(int(id)); }
+    }
+    require(!order.empty(),"No finite candidates");
+    // torch.sort is not stable and its equal-score order varies by backend.
+    // The native API freezes a portable policy: ascending global token ID.
+    std::sort(order.begin(), order.end(), [&](int a, int b) {
+        return scores[a] == scores[b] ? a < b : scores[a] > scores[b];
+    });
+    std::vector<float> sorted;
+    sorted.reserve(order.size());
+    for (int id : order) { sorted.push_back(scores[id]); }
+    const auto probs = score_probabilities(sorted);
+    filtered_distribution result;
+    result.scores.assign(scores.size(), -std::numeric_limits<float>::infinity());
+    std::vector<bool> kept(order.size(), false);
+    double cumulative = 0;
+    const float divisor = std::max(temperature, 1e-5f);
+    for (size_t rank = 0; rank < order.size(); ++rank) {
+        cumulative += probs[rank];
+        const bool keep = rank == 0 || (float(cumulative) <= p && rank < size_t(k));
+        if (keep && std::isfinite(sorted[rank])) {
+            const int id = order[rank];
+            result.scores[id] = scores[id] / divisor;
+            result.kept_ids.push_back(id);
+            kept[rank] = true;
+        }
+    }
+    for (size_t rank = 1; rank < order.size(); ++rank) {
+        if (std::isfinite(sorted[rank]) && sorted[rank] == sorted[rank-1] && kept[rank] != kept[rank-1]) {
+            result.cutoff_tie = true;
+        }
+    }
+    require(!result.kept_ids.empty(), "No retained finite candidates");
+    return result;
+}
+int greedy_choice(const std::vector<float> & scores) {
+    require(!scores.empty(), "Empty logits");
+    const int selected = int(std::max_element(scores.begin(), scores.end()) - scores.begin());
+    require(std::isfinite(scores[selected]), "No finite greedy candidate");
+    return selected;
+}
+int exponential_race_choice(const std::vector<float> & scores, const std::vector<float> & uniforms) {
+    require(uniforms.size() == scores.size(), "Uniform vector has wrong vocabulary size");
+    const auto probs = score_probabilities(scores);
+    float best = -1;
+    int selected = -1;
+    for (size_t id = 0; id < scores.size(); ++id) {
+        const float u = uniforms[id];
+        require(std::isfinite(u) && u >= 0 && u < 1, "Uniforms must be in [0,1)");
+        const float noise = -std::log(u);
+        const float value = probs[id] / noise;
+        if (value > best) { best = value; selected = int(id); }
+    }
+    // Degenerate replay vectors could make every finite candidate race zero.
+    // Refuse to emit a masked token rather than return a nonsensical code.
+    require(selected >= 0 && std::isfinite(scores[selected]), "Uniform race selected a masked candidate");
+    return selected;
+}
+std::vector<float> mask_semantic_logits(const std::vector<float> & full_logits) {
+    require(full_logits.size() == slow_vocabulary_size, "Wrong semantic vocabulary size");
+    for (float value : full_logits) { require(!std::isnan(value) && value != std::numeric_limits<float>::infinity(), "NaN or positive infinity model logits"); }
+    std::vector<float> masked(full_logits.size(), -std::numeric_limits<float>::infinity());
+    std::copy(full_logits.begin()+semantic_begin_id, full_logits.begin()+semantic_end_id+1, masked.begin()+semantic_begin_id);
+    masked[eos_token_id] = full_logits[eos_token_id];
+    return masked;
+}
+semantic_choice choose_semantic(const std::vector<float> & full_logits, const sampling_options & options,
+                                const std::vector<int> * previous, uniform_source & random) {
+    options.validate();
+    const auto masked = mask_semantic_logits(full_logits);
+    const auto regular = process_scores(masked, options.top_k, options.top_p, options.temperature);
+    semantic_choice result;
+    result.cutoff_tie = regular.cutoff_tie;
+    if (!options.do_sample) {
+        result.token = result.normal = greedy_choice(regular.scores);
+        return result;
+    }
+    result.normal = exponential_race_choice(regular.scores, random.draw(masked.size()));
+    const auto high = process_scores(masked, options.top_k, options.ras_top_p, options.ras_temperature);
+    result.high = exponential_race_choice(high.scores, random.draw(masked.size()));
+    result.cutoff_tie = result.cutoff_tie || high.cutoff_tie;
+    const bool repeated = previous && std::find(previous->begin(),previous->end(),result.normal) != previous->end();
+    result.ras_applied = repeated && result.normal >= semantic_begin_id && result.normal <= semantic_end_id;
+    result.token = result.ras_applied ? result.high : result.normal;
+    return result;
+}
+int choose_acoustic(const std::vector<float> & logits, const sampling_options & options,
+                    uniform_source & random, bool * cutoff_tie) {
+    options.validate();
+    require(logits.size() == acoustic_vocabulary_size, "Wrong acoustic vocabulary size");
+    for (float value : logits) { require(!std::isnan(value) && value != std::numeric_limits<float>::infinity(), "NaN or positive infinity model logits"); }
+    const auto processed = process_scores(logits, options.top_k, options.top_p, options.temperature);
+    if (cutoff_tie) { *cutoff_tie = processed.cutoff_tie; }
+    return options.do_sample ? exponential_race_choice(processed.scores, random.draw(logits.size())) : greedy_choice(processed.scores);
+}
+ras_history::ras_history(size_t window) : window_(window) { require(window > 0 && window <= 2048, "Invalid RAS window"); }
+void ras_history::accept(int token) {
+    if (!initialized_) {
+        // Preserve the release's first-step initialization (first token omitted).
+        values_.assign(window_, 0);
+        initialized_ = true;
+    } else {
+        std::rotate(values_.begin(), values_.begin()+1, values_.end());
+        values_.back() = token;
+    }
+}
+void ras_history::reset() { initialized_ = false; values_.clear(); }
+} // namespace audio8
diff --git a/tools/audio8/audio8-sampling.h b/tools/audio8/audio8-sampling.h
new file mode 100644
index 0000000..eb38dd8
--- /dev/null
+++ b/tools/audio8/audio8-sampling.h
@@ -0,0 +1,80 @@
+#pragma once
+#include <cstdint>
+#include <random>
+#include <string>
+#include <vector>
+
+namespace audio8 {
+constexpr int semantic_begin_id = 151678;
+constexpr int semantic_end_id = 155773;
+constexpr int eos_token_id = 151645;
+constexpr int slow_vocabulary_size = 155776;
+constexpr int acoustic_vocabulary_size = 4096;
+
+struct sampling_options {
+    bool do_sample = true;
+    int top_k = 50;
+    float top_p = 0.9f;
+    float temperature = 0.7f;
+    int ras_window_size = 10;
+    float ras_top_p = 0.9f;
+    float ras_temperature = 1.0f;
+    void validate() const;
+};
+
+struct filtered_distribution {
+    std::vector<float> scores;
+    std::vector<int> kept_ids;
+    bool cutoff_tie = false;
+};
+
+// Portable production RNG. Equal seeds reproduce this implementation, not torch.
+// Replay tapes supply one full vocabulary vector for each official random draw.
+class uniform_source {
+public:
+    explicit uniform_source(uint32_t seed = 0);
+    explicit uniform_source(std::vector<float> tape);
+    std::vector<float> draw(size_t count);
+    uint64_t consumed() const { return consumed_; }
+    std::string algorithm() const;
+private:
+    std::mt19937 engine_;
+    std::vector<float> tape_;
+    bool replay_ = false;
+    uint64_t consumed_ = 0;
+};
+
+struct semantic_choice {
+    int token = -1;
+    int normal = -1;
+    int high = -1;
+    bool ras_applied = false;
+    bool cutoff_tie = false;
+};
+
+filtered_distribution process_scores(const std::vector<float> & scores, int top_k,
+                                    float top_p, float temperature);
+std::vector<float> score_probabilities(const std::vector<float> & scores);
+int greedy_choice(const std::vector<float> & scores);
+int exponential_race_choice(const std::vector<float> & scores,
+                            const std::vector<float> & uniforms);
+std::vector<float> mask_semantic_logits(const std::vector<float> & full_logits);
+semantic_choice choose_semantic(const std::vector<float> & full_logits,
+                                const sampling_options & options,
+                                const std::vector<int> * previous,
+                                uniform_source & random);
+int choose_acoustic(const std::vector<float> & logits, const sampling_options & options,
+                    uniform_source & random, bool * cutoff_tie = nullptr);
+
+class ras_history {
+public:
+    explicit ras_history(size_t window = 10);
+    const std::vector<int> * previous() const { return initialized_ ? &values_ : nullptr; }
+    void accept(int semantic_token);
+    void reset();
+private:
+    size_t window_;
+    bool initialized_ = false;
+    std::vector<int> values_;
+};
+} // namespace audio8
