+++ b/tools/audio8/audio8-audio-io.h
@@ -0,0 +1,23 @@
+#pragma once
+#include <string>
+#include <vector>
+
+namespace audio8 {
+struct audio_buffer {
+    std::vector<float> samples;
+    int sample_rate = 44100;
+};
+
+// WAV RIFF little endian only: PCM U8/S16/S24/S32 or IEEE F32/F64,
+// mono/stereo. Float32 channel mean follows the official file-input path.
+// Supported input rates: 8000,11025,12000,16000,22050,24000,32000,
+// 44100,48000,88200,96000,192000. Result is mono F32 at 44100 Hz.
+// Limits: 256 MiB file, 600 seconds, finite nonempty samples.
+// Other formats/rates fail explicitly. No implicit clipping or normalization.
+audio_buffer read_audio(const std::string & path);
+
+// Writes a new mono IEEE-F32 WAV with a fact chunk; refuses existing output.
+// Does not resample. sample_rate is encoded as provided (positive integer).
+void write_wav_float32(const std::string & path, const std::vector<float> & pcm,
+                       int sample_rate = 44100);
+} // namespace audio8
diff --git a/tools/audio8/audio8-codec-decoder-stream.cpp b/tools/audio8/audio8-codec-decoder-stream.cpp
new file mode 100644
index 0000000..f4cd5e4
--- /dev/null
+++ b/tools/audio8/audio8-codec-decoder-stream.cpp
@@ -0,0 +1,144 @@
+#include "audio8-codec-decoder-stream.h"
+#include <algorithm>
+#include <cmath>
+#include <limits>
+
+namespace audio8 {
+namespace {
+void check(bool ok,const char * why) {if(!ok)throw std::runtime_error(why);}
+void emit(const CodecTrace & trace,const std::string & name,const CodecPostTensor & x) {
+    check(x.c>0&&x.t>0&&x.data.size()==size_t(x.c)*x.t,"decoder activation shape mismatch");
+    for(float v:x.data)check(std::isfinite(v),"nonfinite streaming decoder activation");
+    if(trace)trace(name,x.data.data(),x.t,x.c);
+}
+CodecPostTensor tensor(CausalWindow window) {
+    check(window.rows<=size_t(std::numeric_limits<int>::max())&&window.channels<=size_t(std::numeric_limits<int>::max()),"decoder window too large");
+    CodecPostTensor x;x.c=int(window.channels);x.t=int(window.rows);x.data=std::move(window.data);return x;
+}
+CodecPostTensor crop(CodecPostTensor x,size_t prefix) {
+    check(prefix<size_t(x.t),"decoder history crop removes all new rows");
+    const size_t count=(size_t(x.t)-prefix)*x.c;
+    std::move(x.data.begin()+prefix*x.c,x.data.end(),x.data.begin());
+    x.data.resize(count);x.t-=int(prefix);return x;
+}
+}
+struct CodecDecoderStream::Impl {
+    Codec & codec;
+    CodecPostStream post;
+    std::vector<CausalHistory> histories;
+    std::vector<TransposeOverlap> overlaps;
+    std::array<std::vector<float>,4> biases;
+    int position=0;
+    StreamStateStatus status=StreamStateStatus::active;
+    explicit Impl(Codec & owner) : codec(owner),post(owner) {
+        histories.reserve(16);
+        histories.emplace_back(1024,6,2048*2); // upsample0 ConvNeXt raw input
+        histories.emplace_back(1024,6,2048*4); // upsample1 ConvNeXt raw input
+        histories.emplace_back(1024,6,2048*4); // decoder initial conv raw input
+        const int channels[]={768,384,192,96},strides[]={8,8,4,2};
+        uint64_t scale=4;
+        for(int block=0;block<4;++block) {
+            overlaps.emplace_back(channels[block],2*strides[block],strides[block],2048*scale);
+            scale*=strides[block];
+            for(int dilation:{1,3,9})histories.emplace_back(channels[block],6*dilation,2048*scale);
+        }
+        histories.emplace_back(96,6,2048*2048); // final Snake OUTPUT, then conv
+    }
+    void poll(const Cancel & cancel) {if(cancel&&cancel())throw CodecDecoderCancelled();}
+    void abort() noexcept {
+        post.abort();for(auto & x:histories)x.abort();for(auto & x:overlaps)x.abort();status=StreamStateStatus::aborted;
+    }
+    void fail() noexcept {abort();status=StreamStateStatus::failed;}
+};
+CodecDecoderStream::CodecDecoderStream(Codec & codec) : impl(new Impl(codec)) {
+    const int channels[]={768,384,192,96};
+    for(int i=0;i<4;++i)impl->biases[size_t(i)]=CodecDecoderAccess::bias(codec,"decoder.model."+std::to_string(i+1)+".block.1.conv",channels[i]);
+}
+CodecDecoderStream::~CodecDecoderStream()=default;
+StreamStateStatus CodecDecoderStream::status() const noexcept {return impl->status;}
+int CodecDecoderStream::position() const noexcept {return impl->position;}
+size_t CodecDecoderStream::state_bytes() const noexcept {
+    size_t n=impl->post.state_bytes();for(const auto & x:impl->histories)n+=x.state_bytes();for(const auto & x:impl->overlaps)n+=x.state_bytes();return n;
+}
+void CodecDecoderStream::abort() noexcept {impl->abort();}
+void CodecDecoderStream::reset() {
+    try {
+        impl->post.reset();for(auto & x:impl->histories)x.reset();for(auto & x:impl->overlaps)x.reset();
+        impl->position=0;impl->status=StreamStateStatus::active;
+    } catch(...) {impl->fail();throw;}
+}
+void CodecDecoderStream::finish() {
+    if(impl->status==StreamStateStatus::finished)return;
+    check(impl->status==StreamStateStatus::active,"cannot finish failed or aborted decoder stream");
+    try {
+        impl->post.finish();for(auto & x:impl->histories)x.finish();for(auto & x:impl->overlaps)x.finish();
+        impl->status=StreamStateStatus::finished;
+    } catch(...) {impl->fail();throw;}
+}
+CodecDecoderChunk CodecDecoderStream::push(const std::vector<int32_t> & codes,int frames,CodecTrace trace,Cancel cancel) {
+    check(impl->status==StreamStateStatus::active,"decoder stream is not active");
+    check(frames>0&&frames<=2048-impl->position,"decoder push exceeds cumulative code frame limit");
+    check(codes.size()==size_t(10)*frames,"decoder push requires ten complete codebook rows");
+    try {
+        impl->poll(cancel);
+        auto post=impl->post.push(codes,frames,trace,cancel);
+        check(post.frame_offset==impl->position,"post/decoder code offset mismatch");
+        auto x=std::move(post.activation);
+        auto with_history=[&](int index,uint64_t scale,const CodecPostTensor & input) {
+            impl->poll(cancel);
+            auto window=impl->histories[size_t(index)].push(input.data,size_t(input.t),cancel);
+            check(window.input_offset==uint64_t(impl->position)*scale,"decoder per-layer history offset mismatch");
+            return window;
+        };
+        for(int i=0;i<2;++i) {
+            const std::string p="quantizer.upsample."+std::to_string(i);
+            impl->poll(cancel);
+            x=CodecDecoderAccess::transpose(impl->codec,x,p+".0.conv",2);emit(trace,p+".0",x);
+            auto window=with_history(i,uint64_t(2)<<i,x);const size_t prefix=window.prefix_rows;
+            x=crop(CodecDecoderAccess::convnext(impl->codec,tensor(std::move(window)),p+".1"),prefix);
+            emit(trace,p+".1",x);emit(trace,p,x);
+        }
+        emit(trace,"quantizer.decode",x);
+        {
+            auto window=with_history(2,4,x);const size_t prefix=window.prefix_rows;
+            x=crop(CodecDecoderAccess::conv(impl->codec,tensor(std::move(window)),"decoder.model.0.conv"),prefix);
+            emit(trace,"decoder.model.0",x);
+        }
+        uint64_t scale=4;const int strides[]={8,8,4,2},dilations[]={1,3,9};
+        for(int block=0;block<4;++block) {
+            const std::string p="decoder.model."+std::to_string(block+1);
+            impl->poll(cancel);
+            x=CodecDecoderAccess::snake(impl->codec,x,p+".block.0");
+            const int input_rows=x.t;
+            auto raw=CodecDecoderAccess::transpose_raw(impl->codec,x,p+".block.1.conv",strides[block]);
+            auto merged=impl->overlaps[size_t(block)].merge(raw.data,size_t(input_rows),impl->biases[size_t(block)],cancel);
+            check(merged.input_offset==uint64_t(impl->position)*scale,"decoder transpose input offset mismatch");
+            scale*=strides[block];
+            check(merged.output_offset==uint64_t(impl->position)*scale,"decoder transpose output offset mismatch");
+            check(merged.rows<=size_t(std::numeric_limits<int>::max()),"decoder transpose rows exceed int range");
+            x.c=int(merged.channels);x.t=int(merged.rows);x.data=std::move(merged.data);emit(trace,p+".block.1",x);
+            for(int unit=0;unit<3;++unit) {
+                const std::string name=p+".block."+std::to_string(unit+2);
+                auto window=with_history(3+3*block+unit,scale,x);const size_t prefix=window.prefix_rows;
+                x=crop(CodecDecoderAccess::residual(impl->codec,tensor(std::move(window)),name,dilations[unit]),prefix);
+                emit(trace,name,x);
+            }
+            emit(trace,p,x);
+        }
+        impl->poll(cancel);
+        x=CodecDecoderAccess::snake(impl->codec,x,"decoder.model.5");
+        auto window=with_history(15,2048,x);const size_t prefix=window.prefix_rows;
+        x=crop(CodecDecoderAccess::conv(impl->codec,tensor(std::move(window)),"decoder.model.6.conv"),prefix);
+        emit(trace,"decoder.model.6",x);
+        for(auto & v:x.data)v=std::tanh(v);
+        emit(trace,"decoder",x);
+        check(x.c==1&&x.t==frames*2048,"incremental decoder PCM length mismatch");
+        impl->poll(cancel);
+        CodecDecoderChunk result{impl->position,uint64_t(impl->position)*2048,std::move(x.data)};
+        impl->position+=frames;return result;
+    } catch(const CodecPostCancelled &) {impl->abort();throw CodecDecoderCancelled();}
+      catch(const StreamStateCancelled &) {impl->abort();throw CodecDecoderCancelled();}
+      catch(const CodecDecoderCancelled &) {impl->abort();throw;}
+      catch(...) {impl->fail();throw;}
+}
+}
