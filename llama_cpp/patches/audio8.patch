+struct engine_settings {
+    std::string slow_model;
+    std::string fast_model;
+    std::string codebook_embeddings;
+    int threads = 4;
+    int gpu_layers = 0;
+};
+struct ar_request {
+    std::vector<std::vector<int>> prompt_columns;
+    int max_frames = 512;
+    sampling_options sampling;
+    uint32_t seed = 0;
+    std::string uniform_tape_path;
+    std::string trace_directory;
+};
+struct frame_event {
+    int index = 0;
+    int semantic_token = -1;
+    std::vector<int> codes;
+    bool emitted = false;
+    bool ras_applied = false;
+    bool cutoff_tie = false;
+    double slow_ms = 0;
+    double fast_ms = 0;
+};
+struct ar_response {
+    std::vector<std::vector<int>> frames;
+    std::vector<frame_event> steps;
+    std::string stop_reason;
+    std::string rng_algorithm;
+    uint64_t uniform_values_consumed = 0;
+    int effective_max_frames = 0;
+    double ar_wall_ms = 0;
+};
+using frame_callback = std::function<bool(const frame_event &)>;
+using cancellation_check = std::function<bool()>;
+
+// Reuses loaded weights and contexts. Requests are serialized; every request
+// resets both caches and creates a fresh RNG/RAS window.
+class ar_engine {
+public:
+    explicit ar_engine(const engine_settings & settings);
+    ~ar_engine();
+    ar_engine(const ar_engine &) = delete;
+    ar_engine & operator=(const ar_engine &) = delete;
+    ar_response generate(const ar_request & request, frame_callback callback = {}, cancellation_check cancel = {});
+    double load_ms() const;
+    const ::llama_model * text_model() const;
+    std::string system_info() const;
+private:
+    struct impl;
+    std::unique_ptr<impl> impl_;
+};
+} // namespace audio8
diff --git a/tools/audio8/audio8-audio-io.cpp b/tools/audio8/audio8-audio-io.cpp
new file mode 100644
index 0000000..09dd5e1
--- /dev/null
+++ b/tools/audio8/audio8-audio-io.cpp
@@ -0,0 +1,184 @@
+#include "audio8-audio-io.h"
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <limits>
+#include <numeric>
+#include <stdexcept>
+
+namespace audio8 {
+namespace {
+constexpr uint64_t max_file_bytes = 256ull * 1024 * 1024;
+constexpr uint64_t max_seconds = 600;
+constexpr int output_rate = 44100;
+static void require(bool condition, const char * message) {
+    if (!condition) { throw std::invalid_argument(message); }
+}
+static uint16_t u16(const uint8_t * p) {
+    return uint16_t(p[0]) | uint16_t(uint16_t(p[1]) << 8);
+}
+static uint32_t u32(const uint8_t * p) {
+    return uint32_t(p[0]) | (uint32_t(p[1]) << 8) | (uint32_t(p[2]) << 16) | (uint32_t(p[3]) << 24);
+}
+static uint64_t u64(const uint8_t * p) {
+    return uint64_t(u32(p)) | (uint64_t(u32(p + 4)) << 32);
+}
+static bool tag(const uint8_t * p, const char * s) { return std::memcmp(p, s, 4) == 0; }
+static float sample(const uint8_t * p, int format, int bits) {
+    float value = 0;
+    if (format == 3) {
+        if (bits == 32) { const auto v = u32(p); std::memcpy(&value, &v, sizeof(value)); }
+        else { const auto v = u64(p); double d; std::memcpy(&d, &v, sizeof(d)); value = float(d); }
+    } else if (bits == 8) {
+        value = float(int(p[0]) - 128) / 128.0f;
+    } else {
+        uint32_t raw = bits == 16 ? u16(p) : bits == 24 ? (uint32_t(p[0]) | (uint32_t(p[1]) << 8) | (uint32_t(p[2]) << 16)) : u32(p);
+        const int64_t signed_value = (raw & (uint32_t(1) << (bits - 1))) ? int64_t(raw) - (int64_t(1) << bits) : int64_t(raw);
+        value = float(signed_value) / float(uint64_t(1) << (bits - 1));
+    }
+    require(std::isfinite(value), "WAV contains nonfinite or F32-overflow samples");
+    return value;
+}
+static bool supported_rate(int rate) {
+    const int rates[] = {8000,11025,12000,16000,22050,24000,32000,44100,48000,88200,96000,192000};
+    return std::find(std::begin(rates), std::end(rates), rate) != std::end(rates);
+}
+
+// Same mathematical kernel and operation order as torchaudio's default
+// _get_sinc_resample_kernel for a Float32 input. libm and conv accumulation
+// can differ from PyTorch CPU vector kernels: numerical parity, not bitwise.
+static std::vector<float> resample(const std::vector<float> & input, int source_rate) {
+    if (source_rate == output_rate) { return input; }
+    const int divisor = std::gcd(source_rate, output_rate);
+    const int orig = source_rate / divisor;
+    const int target = output_rate / divisor;
+    const double base = std::min(orig, target) * 0.99;
+    const int width = int(std::ceil(6.0 * orig / base));
+    const int kernel_length = 2 * width + orig;
+    const uint64_t kernel_count = uint64_t(target) * kernel_length;
+    require(kernel_count <= 1024 * 1024, "Resampler kernel exceeds explicit memory budget");
+    std::vector<float> kernel(size_t(kernel_count), 0.0f);
+    const float pi = float(3.141592653589793238462643383279502884);
+    const float scale = float(base / orig);
+    for (int phase = 0; phase < target; ++phase) {
+        const float offset = float(-phase) / float(target);
+        for (int tap = 0; tap < kernel_length; ++tap) {
+            const float index = float(tap - width) / float(orig);
+            float t = (offset + index) * float(base);
+            t = std::clamp(t, -6.0f, 6.0f);
+            float angle = t * pi;
+            angle /= 6.0f;
+            angle /= 2.0f;
+            const float cosine = std::cos(angle);
+            const float window = cosine * cosine;
+            t *= pi;
+            float sinc = t == 0 ? 1.0f : std::sin(t) / t;
+            sinc *= window * scale;
+            kernel[size_t(phase) * kernel_length + tap] = sinc;
+        }
+    }
+    // The pinned official implementation converts this Python-float ratio
+    // to a default Float32 tensor before ceil. Keep its length rounding,
+    // including near-integer cases where mathematical integer ceil differs.
+    const float target_length = float(double(target) * double(input.size()) / orig);
+    const uint64_t out_count = uint64_t(std::ceil(target_length));
+    require(out_count > 0 && out_count <= uint64_t(output_rate) * max_seconds, "Invalid resampled length");
+    std::vector<float> output(size_t(out_count), 0.0f);
+    for (size_t j = 0; j < output.size(); ++j) {
+        const size_t phase = j % size_t(target);
+        const int64_t first = int64_t(j / size_t(target)) * orig - width;
+        const float * coefficients = kernel.data() + phase * kernel_length;
+        float sum = 0.0f;
+        const int start = int(std::max<int64_t>(0, -first));
+        const int end = int(std::min<int64_t>(kernel_length, int64_t(input.size()) - first));
+        for (int k = start; k < end; ++k) { sum += input[size_t(first + k)] * coefficients[k]; }
+        require(std::isfinite(sum), "Nonfinite resampled audio");
+        output[j] = sum;
+    }
+    return output;
+}
+static void put16(std::ostream & out, uint16_t x) {
+    const char bytes[] = {char(x & 255), char((x >> 8) & 255)}; out.write(bytes, sizeof(bytes));
+}
+static void put32(std::ostream & out, uint32_t x) {
+    const char bytes[] = {char(x & 255), char((x >> 8) & 255), char((x >> 16) & 255), char((x >> 24) & 255)};
+    out.write(bytes, sizeof(bytes));
+}
+} // namespace
+
+audio_buffer read_audio(const std::string & path) {
+    const auto input_path = std::filesystem::u8path(path);
+    const auto size = std::filesystem::file_size(input_path);
+    require(size >= 12 && size <= max_file_bytes, "WAV size must be in [12 bytes,256 MiB]");
+    std::vector<uint8_t> bytes(size_t(size), 0);
+    std::ifstream stream(input_path, std::ios::binary);
+    require(bool(stream.read(reinterpret_cast<char *>(bytes.data()), std::streamsize(size))), "Cannot read WAV");
+    require(tag(bytes.data(), "RIFF") && tag(bytes.data() + 8, "WAVE"), "Only RIFF little-endian WAV is supported (no RF64/RIFX/MP3/FLAC)");
+    const uint64_t end = uint64_t(u32(bytes.data() + 4)) + 8;
+    require(end >= 12 && end <= size, "Truncated or invalid RIFF size");
+    uint64_t format_offset = 0, format_size = 0, data_offset = 0, data_size = 0;
+    for (uint64_t offset = 12; offset < end;) {
+        require(end - offset >= 8, "Incomplete WAV chunk header");
+        const auto length = uint64_t(u32(bytes.data() + offset + 4));
+        require(length <= end - offset - 8, "WAV chunk exceeds RIFF bounds");
+        const auto next = offset + 8 + length + (length & 1);
+        require(next <= end, "Missing WAV chunk padding");
+        if (tag(bytes.data() + offset, "fmt ")) {
+            require(format_offset == 0, "Duplicate WAV format chunk"); format_offset = offset + 8; format_size = length;
+        } else if (tag(bytes.data() + offset, "data")) {
+            require(data_offset == 0, "Multiple WAV data chunks are unsupported"); data_offset = offset + 8; data_size = length;
+        }
+        offset = next;
+    }
+    require(format_offset && format_size >= 16 && data_offset && data_size, "WAV requires a format and nonempty data chunk");
+    const uint8_t * fmt = bytes.data() + format_offset;
+    int format = u16(fmt), channels = u16(fmt + 2), bits = u16(fmt + 14);
+    const uint32_t rate = u32(fmt + 4), byte_rate = u32(fmt + 8), block = u16(fmt + 12);
+    if (format == 0xfffe) {
+        require(format_size >= 40 && u16(fmt + 16) >= 22 && uint64_t(u16(fmt + 16)) + 18 <= format_size, "Invalid WAVE_FORMAT_EXTENSIBLE chunk");
+        const uint8_t guid_tail[] = {0,0,0x10,0,0x80,0,0,0xaa,0,0x38,0x9b,0x71};
+        require(std::memcmp(fmt + 28, guid_tail, sizeof(guid_tail)) == 0, "Unsupported extensible WAV subformat GUID");
+        require(u16(fmt + 18) == bits, "Packed valid-bit WAV containers are unsupported");
+        const auto subformat = u32(fmt + 24);
+        require(subformat == 1 || subformat == 3, "Unsupported extensible WAV sample format");
+        format = int(subformat);
+    }
+    require(channels == 1 || channels == 2, "Only mono/stereo WAV is supported");
+    require(rate <= uint32_t(std::numeric_limits<int>::max()) && supported_rate(int(rate)), "Unsupported input sample rate; use one of the documented tested rates");
+    require((format == 1 && (bits == 8 || bits == 16 || bits == 24 || bits == 32)) || (format == 3 && (bits == 32 || bits == 64)), "Unsupported WAV encoding/bit depth");
+    require(block == uint32_t(channels * (bits / 8)) && uint64_t(byte_rate) == uint64_t(rate) * block, "Inconsistent WAV block align/byte rate");
+    require(data_size % block == 0, "Partial WAV sample frame");
+    const uint64_t frames = data_size / block;
+    require(frames > 0 && frames <= uint64_t(rate) * max_seconds, "Reference audio must be nonempty and at most 600 seconds");
+    std::vector<float> mono(size_t(frames), 0.0f);
+    const uint8_t * data = bytes.data() + data_offset;
+    for (size_t i = 0; i < mono.size(); ++i) {
+        const auto p = data + i * block;
+        float value = sample(p, format, bits);
+        if (channels == 2) { value = (value + sample(p + bits / 8, format, bits)) * 0.5f; }
+        require(std::isfinite(value), "Nonfinite channel mean"); mono[i] = value;
+    }
+    return {resample(mono, int(rate)), output_rate};
+}
+
+void write_wav_float32(const std::string & path, const std::vector<float> & pcm, int sample_rate) {
+    require(sample_rate > 0 && uint64_t(sample_rate) * 4 <= std::numeric_limits<uint32_t>::max(), "Invalid output sample rate");
+    require(!pcm.empty() && uint64_t(pcm.size()) * 4 + 50 <= std::numeric_limits<uint32_t>::max(), "Invalid WAV output length");
+    for (float v : pcm) { require(std::isfinite(v), "Cannot write nonfinite WAV samples"); }
+    const auto output_path = std::filesystem::u8path(path);
+    require(!std::filesystem::exists(output_path), "Output WAV already exists");
+    std::ofstream out(output_path, std::ios::binary);
+    require(bool(out), "Cannot create output WAV");
+    const auto data_bytes = uint32_t(pcm.size() * 4);
+    out.write("RIFF", 4); put32(out, data_bytes + 50); out.write("WAVE", 4);
+    out.write("fmt ", 4); put32(out, 18); put16(out, 3); put16(out, 1);
+    put32(out, uint32_t(sample_rate)); put32(out, uint32_t(sample_rate) * 4); put16(out, 4); put16(out, 32); put16(out, 0);
+    out.write("fact", 4); put32(out, 4); put32(out, uint32_t(pcm.size()));
+    out.write("data", 4); put32(out, data_bytes);
+    for (float value : pcm) { uint32_t bits; std::memcpy(&bits, &value, sizeof(bits)); put32(out, bits); }
+    out.flush(); require(bool(out), "Failed to finish output WAV");
+}
+} // namespace audio8
diff --git a/tools/audio8/audio8-audio-io.h b/tools/audio8/audio8-audio-io.h
new file mode 100644
