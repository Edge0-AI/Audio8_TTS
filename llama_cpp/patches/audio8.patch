+# Optional private-fork adapter for the pinned llama.cpp tools.
+if(NOT LLAMA_AUDIO8)
+    return()
+endif()
+if(EMSCRIPTEN OR NOT TARGET llama OR NOT TARGET ggml-cpu)
+    message(FATAL_ERROR "Audio8 requires native llama and the GGML CPU backend")
+endif()
+include(GNUInstallDirs)
+find_package(Threads REQUIRED)
+set(AUDIO8_LLAMA_CPP_SOURCE_DIR "${PROJECT_SOURCE_DIR}")
+set(AUDIO8_TEXT_BUILD_CLI OFF CACHE BOOL "Build isolated text processor CLI" FORCE)
+include("${CMAKE_CURRENT_SOURCE_DIR}/audio8-text-processor.cmake")
+
+option(AUDIO8_BUILD_SERVER "Enable Audio8 dispatch in llama-server" OFF)
+if(APPLE OR MSVC)
+    set(_audio8_openmp_default OFF)
+else()
+    set(_audio8_openmp_default ON)
+endif()
+option(AUDIO8_CODEC_OPENMP "Parallelize the native codec CPU kernels" ${_audio8_openmp_default})
+option(AUDIO8_CODEC_CUDA "Enable the separately validated native codec CUDA path" OFF)
+option(AUDIO8_CODEC_STREAM "Enable accepted incremental codec decoding" OFF)
+
+add_library(audio8_codec STATIC audio8-codec-native.cpp)
+if(AUDIO8_CODEC_STREAM)
+    target_sources(audio8_codec PRIVATE audio8-codec-stream-state.cpp audio8-codec-post-stream.cpp audio8-codec-decoder-stream.cpp)
+endif()
+target_link_libraries(audio8_codec PUBLIC ggml ggml-base ggml-cpu)
+target_include_directories(audio8_codec PUBLIC "${CMAKE_CURRENT_SOURCE_DIR}")
+if(AUDIO8_CODEC_CUDA)
+    if(NOT TARGET ggml-cuda)
+        message(FATAL_ERROR "GGML_CUDA requires the ggml-cuda target")
+    endif()
+    target_compile_definitions(audio8_codec PRIVATE AUDIO8_CODEC_CUDA=1)
+    target_link_libraries(audio8_codec PUBLIC ggml-cuda)
+endif()
+if(AUDIO8_CODEC_OPENMP)
+    find_package(OpenMP COMPONENTS CXX REQUIRED)
+    target_link_libraries(audio8_codec PUBLIC OpenMP::OpenMP_CXX)
+endif()
+
+add_library(audio8_audio_io STATIC audio8-audio-io.cpp)
+target_include_directories(audio8_audio_io PUBLIC "${CMAKE_CURRENT_SOURCE_DIR}")
+
+add_library(audio8_tts STATIC
+    audio8-ar-engine.cpp audio8-sampling.cpp audio8-tts.cpp audio8-tts-tool.cpp)
+if(AUDIO8_CODEC_STREAM)
+    target_compile_definitions(audio8_tts PRIVATE AUDIO8_CODEC_STREAM=1)
+endif()
+target_include_directories(audio8_tts PUBLIC "${CMAKE_CURRENT_SOURCE_DIR}"
+    PRIVATE "${PROJECT_SOURCE_DIR}/src" "${PROJECT_SOURCE_DIR}/vendor/nlohmann")
+target_link_libraries(audio8_tts PUBLIC llama ggml audio8_text_processor
+    audio8_codec audio8_audio_io Threads::Threads)
+if(WIN32)
+    target_link_libraries(audio8_tts PRIVATE shell32)
+endif()
+if(AUDIO8_BUILD_SERVER)
+    if(NOT LLAMA_BUILD_SERVER OR NOT TARGET cpp-httplib)
+        message(FATAL_ERROR "AUDIO8_BUILD_SERVER requires LLAMA_BUILD_SERVER and cpp-httplib")
+    endif()
+    if(NOT EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/audio8-tts-server.cpp")
+        message(FATAL_ERROR "Audio8 server implementation is not in the frozen source snapshot")
+    endif()
+    target_sources(audio8_tts PRIVATE audio8-tts-server.cpp)
+    target_include_directories(audio8_tts PRIVATE "${PROJECT_SOURCE_DIR}/vendor/cpp-httplib")
+    target_link_libraries(audio8_tts PRIVATE cpp-httplib)
+    install(TARGETS cpp-httplib ARCHIVE DESTINATION "${CMAKE_INSTALL_LIBDIR}" COMPONENT Audio8SDK)
+endif()
+foreach(_target IN ITEMS audio8_codec audio8_audio_io audio8_tts)
+    target_compile_features(${_target} PUBLIC cxx_std_17)
+    set_target_properties(${_target} PROPERTIES POSITION_INDEPENDENT_CODE ON)
+    if(MSVC)
+        target_compile_options(${_target} PRIVATE /fp:strict)
+    else()
+        target_compile_options(${_target} PRIVATE -ffp-contract=off -fno-fast-math)
+    endif()
+endforeach()
+
+install(TARGETS audio8_tts audio8_codec audio8_audio_io audio8_text_processor
+    ARCHIVE DESTINATION "${CMAKE_INSTALL_LIBDIR}" COMPONENT Audio8SDK)
+install(FILES audio8-tts.h audio8-tts-tool.h audio8-ar-engine.h audio8-sampling.h
+    audio8-codec-native.h audio8-audio-io.h audio8-text-processor.h audio8-platform.h
+    DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/audio8" COMPONENT Audio8SDK)
+file(GLOB _audio8_llama_headers "${PROJECT_SOURCE_DIR}/include/*.h")
+file(GLOB _audio8_ggml_headers "${PROJECT_SOURCE_DIR}/ggml/include/*.h")
+install(FILES ${_audio8_llama_headers} ${_audio8_ggml_headers}
+    DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}" COMPONENT Audio8SDK)
+install(DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/licenses/"
+    DESTINATION "${CMAKE_INSTALL_DATADIR}/audio8/licenses" COMPONENT Audio8Runtime)
+install(FILES "${CMAKE_CURRENT_SOURCE_DIR}/source-manifest.json"
+    DESTINATION "${CMAKE_INSTALL_DATADIR}/audio8" COMPONENT Audio8Runtime)
+
+# Called after tools/ has defined mtmd and the public executables.
+function(audio8_install_tools)
+    set(_runtime_targets llama-tts llama llama-common ggml ggml-base ggml-cpu mtmd)
+    if(GGML_CUDA)
+        list(APPEND _runtime_targets ggml-cuda)
+    endif()
+    if(TARGET ggml-metal)
+        list(APPEND _runtime_targets ggml-metal)
+    endif()
+    if(TARGET ggml-blas)
+        list(APPEND _runtime_targets ggml-blas)
+    endif()
+    if(AUDIO8_BUILD_SERVER)
+        list(APPEND _runtime_targets llama-server llama-server-impl)
+    endif()
+    install(TARGETS ${_runtime_targets}
+        RUNTIME DESTINATION "${CMAKE_INSTALL_BINDIR}" COMPONENT Audio8Runtime
+        LIBRARY DESTINATION "${CMAKE_INSTALL_LIBDIR}" COMPONENT Audio8Runtime
+        ARCHIVE DESTINATION "${CMAKE_INSTALL_LIBDIR}" COMPONENT Audio8SDK)
+endfunction()
+
+if(AUDIO8_CODEC_STREAM)
+    install(FILES audio8-codec-stream-state.h audio8-codec-post-stream.h audio8-codec-decoder-stream.h
+        DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/audio8" COMPONENT Audio8SDK)
+endif()
diff --git a/tools/audio8/audio8-ar-engine.cpp b/tools/audio8/audio8-ar-engine.cpp
new file mode 100644
index 0000000..f6a6dfa
--- /dev/null
+++ b/tools/audio8/audio8-ar-engine.cpp
@@ -0,0 +1,308 @@
+#include "llama.h"
+#include "llama-ext.h"
+#include "ggml-backend.h"
+#include "audio8-ar-engine.h"
+#include <cstdlib>
+#include <mutex>
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace fs = std::filesystem;
+using clock_type = std::chrono::steady_clock;
+
+static constexpr int dim = 896;
+static constexpr int codebook_size = 4096;
+static constexpr int num_codebooks = 10;
+static constexpr int semantic_begin = 151678;
+static constexpr int semantic_end = 155773;
+static constexpr int eos_id = 151645;
+static constexpr int slow_vocab = 155776;
+static constexpr int context_size = 2048;
+
+struct model_deleter { void operator()(llama_model * p) const { llama_model_free(p); } };
+struct context_deleter { void operator()(llama_context * p) const { llama_free(p); } };
+using model_ptr = std::unique_ptr<llama_model, model_deleter>;
+using context_ptr = std::unique_ptr<llama_context, context_deleter>;
+
+static void require(bool ok, const std::string & message) {
+    if (!ok) { throw std::runtime_error(message); }
+}
+
+static double elapsed_ms(clock_type::time_point start) {
+    return std::chrono::duration<double, std::milli>(clock_type::now() - start).count();
+}
+
+static std::vector<float> read_f32(const fs::path & path, size_t count) {
+    require(fs::file_size(path) == count * sizeof(float), "Wrong F32 file size: " + path.string());
+    std::vector<float> data(count);
+    std::ifstream stream(path, std::ios::binary);
+    require(bool(stream.read(reinterpret_cast<char *>(data.data()), count * sizeof(float))), "Cannot read " + path.string());
+    for (float value : data) { require(std::isfinite(value), "Nonfinite input tensor"); }
+    return data;
+}
+
+static void write_f32(const fs::path & path, const std::vector<float> & data) {
+    for (float value : data) { require(std::isfinite(value), "Nonfinite output tensor"); }
+    std::ofstream stream(path, std::ios::binary);
+    require(bool(stream.write(reinterpret_cast<const char *>(data.data()), data.size() * sizeof(float))), "Cannot write " + path.string());
+}
+
+static std::string rope_policy(const llama_model * model) {
+    char value[128] = {};
+    const int32_t count = llama_model_meta_val_str(model, "audio8.rope.mode", value, sizeof(value));
+    if (count < 0) { return "upstream_float_rope"; }
+    require(count < int32_t(sizeof(value)), "RoPE metadata exceeds probe limit");
+    return std::string(value, size_t(count));
+}
+
+static model_ptr load_model(const std::string & path, int n_gpu_layers, int vocab) {
+    auto params = llama_model_default_params();
+    params.n_gpu_layers = n_gpu_layers;
+    model_ptr model(llama_model_load_from_file(path.c_str(), params));
+    require(bool(model), "Cannot load model " + path);
+    require(llama_model_n_embd(model.get()) == dim, "Wrong embedding dimension");
+    require(llama_vocab_n_tokens(llama_model_get_vocab(model.get())) == vocab, "Wrong vocabulary size");
+    return model;
+}
+
+struct hidden_capture {
+    std::vector<float> values = std::vector<float>(dim);
+    bool valid = false;
+};
+
+static bool capture_hidden(ggml_tensor * tensor, bool ask, void * user_data) {
+    const bool selected = std::strcmp(tensor->name, "result_norm") == 0;
+    if (ask) { return selected; }
+    if (!selected) { return true; }
+    auto & capture = *static_cast<hidden_capture *>(user_data);
+    if (tensor->type != GGML_TYPE_F32 || tensor->ne[0] != dim || ggml_nrows(tensor) != 1 || !ggml_is_contiguous(tensor)) {
+        return false;
+    }
+    ggml_backend_tensor_get(tensor, capture.values.data(), 0, dim * sizeof(float));
+    capture.valid = true;
+    return true;
+}
+
+static context_ptr make_context(llama_model * model, int threads, int length, hidden_capture * capture) {
+    auto params = llama_context_default_params();
+    params.n_ctx = length;
+    params.n_batch = length;
+    params.n_ubatch = std::min(length, 256);
+    params.n_threads = threads;
+    params.n_threads_batch = threads;
+    // Capture only the selected final hidden, without projecting every prompt token.
+    params.embeddings = false;
+    params.cb_eval = capture ? capture_hidden : nullptr;
+    params.cb_eval_user_data = capture;
+    params.pooling_type = LLAMA_POOLING_TYPE_NONE;
+    params.attention_type = LLAMA_ATTENTION_TYPE_CAUSAL;
+    params.type_k = GGML_TYPE_F32;
+    params.type_v = GGML_TYPE_F32;
+    params.flash_attn_type = LLAMA_FLASH_ATTN_TYPE_DISABLED;
+    context_ptr ctx(llama_init_from_model(model, params));
+    require(bool(ctx), "Cannot create context");
+    return ctx;
+}
+
+static std::vector<float> token_embedding(llama_model * model, int token) {
+    std::vector<float> out(dim);
+    llama_token id = token;
+    require(llama_model_get_tok_embd_rows(model, &id, 1, out.data()) == dim, "Cannot read embedding");
+    return out;
+}
+
+static void check_column(const std::vector<int> & column) {
+    require(column.size() == num_codebooks + 1, "Prompt column must contain 11 IDs");
+    require(column[0] >= 0 && column[0] < slow_vocab, "Invalid token ID");
+    for (int c = 0; c < num_codebooks; ++c) {
+        require(column[c + 1] >= 0 && column[c + 1] < codebook_size, "Invalid code ID");
+    }
+}
+
+static std::vector<float> embed_column(llama_model * model, const std::vector<float> & codebooks, const std::vector<int> & column) {
+    check_column(column);
+    auto out = token_embedding(model, column[0]);
+    if (column[0] >= semantic_begin && column[0] <= semantic_end) {
+        for (int j = 0; j < dim; ++j) {
+            float sum = 0.0f;
+            for (int c = 0; c < num_codebooks; ++c) {
+                const size_t row = size_t(c) * codebook_size + column[c + 1];
+                sum += codebooks[row * dim + j];
+            }
+            out[j] += sum;
+        }
+    }
+    return out;
+}
+
+struct step_output {
+    std::vector<float> hidden;
+    std::vector<float> logits;
+};
+
+static step_output decode(llama_context * ctx, hidden_capture * capture, std::vector<float> & input, int position, int vocab) {
+    require(!input.empty() && input.size() % dim == 0, "Invalid embedding input");
+    const int count = int(input.size() / dim);
+    require(position >= 0 && position + count <= context_size, "Context overflow");
+    std::vector<llama_pos> positions(count);
+    std::vector<int32_t> n_seq(count, 1);
+    llama_seq_id seq = 0;
+    std::vector<llama_seq_id *> seqs(count, &seq);
+    std::vector<int8_t> output(count, 0);
+    for (int i = 0; i < count; ++i) { positions[i] = position + i; }
+    output.back() = 1;
+    llama_batch batch{count, nullptr, input.data(), positions.data(), n_seq.data(), seqs.data(), output.data()};
+    if(capture) { capture->valid = false; }
+    require(llama_decode(ctx, batch) == 0, "llama_decode failed");
+    const float * logits = llama_get_logits_ith(ctx, -1);
+    require(logits && (!capture || capture->valid), "Missing logits or selected final hidden");
+    return {capture ? capture->values : std::vector<float>{}, {logits, logits + vocab}};
+}
+
+namespace audio8 {
+namespace {
+struct backend_lifetime {
+    backend_lifetime() { ggml_backend_load_all(); llama_backend_init(); }
+    ~backend_lifetime() { llama_backend_free(); }
+};
+void initialize_backend() { static backend_lifetime lifetime; }
+}
+struct ar_engine::impl {
+    model_ptr slow_model;
+    model_ptr fast_model;
+    hidden_capture slow_capture;
+    context_ptr slow_ctx;
+    context_ptr fast_ctx;
+    std::vector<float> codebooks;
+    double loading_ms = 0;
+    std::mutex request_mutex;
+    explicit impl(const engine_settings & settings) {
+        require(settings.threads > 0 && settings.threads <= 16, "Threads must be in [1,16]");
+        require(settings.gpu_layers >= 0 && settings.gpu_layers <= 100, "Invalid GPU layer count");
+        if(settings.gpu_layers > 0) {
+            const char * override_value=std::getenv("NVIDIA_TF32_OVERRIDE");
+            require(override_value && std::strcmp(override_value,"0")==0, "Strict CUDA requires NVIDIA_TF32_OVERRIDE=0 and matched F32 dispatch build");
+            const char * compute=std::getenv("GGML_CUDA_CUBLAS_COMPUTE_TYPE");
+            require(!compute || std::strcmp(compute,"f32")==0 || std::strcmp(compute,"fp32")==0 || std::strcmp(compute,"auto")==0,
+                    "Strict F32 policy rejects compute type override");
+        }
+        const auto start=clock_type::now();
+        initialize_backend();
+        slow_model=load_model(settings.slow_model,settings.gpu_layers,slow_vocab);
+        fast_model=load_model(settings.fast_model,settings.gpu_layers,codebook_size);
+        require(rope_policy(slow_model.get())=="official_bf16_table_v1" && rope_policy(fast_model.get())=="official_bf16_table_v1", "Native engine requires official Audio8 table contract");
+        slow_ctx=make_context(slow_model.get(),settings.threads,context_size,&slow_capture);
+        // Fast only consumes its logits; fetching its unused hidden split the
+        // device graph and synchronized the GPU ten times for every frame.
+        fast_ctx=make_context(fast_model.get(),settings.threads,32,nullptr);
+        codebooks=read_f32(fs::u8path(settings.codebook_embeddings),size_t(num_codebooks)*codebook_size*dim);
+        loading_ms=elapsed_ms(start);
+    }
+};
+ar_engine::ar_engine(const engine_settings & settings):impl_(new impl(settings)) {}
+ar_engine::~ar_engine() = default;
+double ar_engine::load_ms() const { return impl_->loading_ms; }
+const ::llama_model * ar_engine::text_model() const { return impl_->slow_model.get(); }
+std::string ar_engine::system_info() const { return llama_print_system_info(); }
+
+ar_response ar_engine::generate(const ar_request & request, frame_callback callback, cancellation_check cancel) {
+    std::lock_guard<std::mutex> lock(impl_->request_mutex);
+    request.sampling.validate();
+    require(!request.prompt_columns.empty() && request.prompt_columns.size()<context_size, "Prompt length must be in [1,2047]");
+    require(request.max_frames>0, "max_frames must be positive");
+    for(const auto & column:request.prompt_columns) { check_column(column); }
+    fs::path trace=fs::u8path(request.trace_directory);
+    if(!trace.empty()) { require(!fs::exists(trace), "Trace directory already exists"); fs::create_directories(trace); }
+    uniform_source random(request.seed);
+    if(!request.uniform_tape_path.empty()) {
+        const auto tape_path=fs::u8path(request.uniform_tape_path);
+        const auto bytes=fs::file_size(tape_path);
+        require(bytes>0 && bytes%sizeof(float)==0 && bytes<=size_t(2)*1024*1024*1024, "Invalid uniform tape file size");
+        random=uniform_source(read_f32(tape_path,bytes/sizeof(float)));
+    }
+    ras_history history(request.sampling.ras_window_size);
+    ar_response result;
+    result.effective_max_frames=std::min(request.max_frames,context_size-int(request.prompt_columns.size()));
+    result.rng_algorithm=random.algorithm();
+    result.stop_reason="max_frames";
+    auto & engine=*impl_;
+    llama_memory_clear(llama_get_memory(engine.slow_ctx.get()),true);
+    llama_memory_clear(llama_get_memory(engine.fast_ctx.get()),true);
+    std::vector<float> input;
+    input.reserve(request.prompt_columns.size()*dim);
+    for(const auto & column:request.prompt_columns) {
+        auto embedded=embed_column(engine.slow_model.get(),engine.codebooks,column);
+        input.insert(input.end(),embedded.begin(),embedded.end());
+    }
+    if(!trace.empty()) { write_f32(trace/"prompt_embeddings.f32",input); }
+    int position=0;
+    const auto started=clock_type::now();
+    for(int frame=0;frame<result.effective_max_frames;++frame) {
+        if(cancel && cancel()) { result.stop_reason="cancelled"; break; }
+        const auto slow_start=clock_type::now();
+        auto slow=decode(engine.slow_ctx.get(),&engine.slow_capture,input,position,slow_vocab);
+        position+=int(input.size()/dim);
+        frame_event event; event.index=frame; event.slow_ms=elapsed_ms(slow_start);
+        for(float value:slow.logits) { require(std::isfinite(value),"Nonfinite slow logits"); }
+        const auto choice=choose_semantic(slow.logits,request.sampling,history.previous(),random);
+        event.semantic_token=choice.token; event.ras_applied=choice.ras_applied; event.cutoff_tie=choice.cutoff_tie;
+        require(choice.token==eos_id || (choice.token>=semantic_begin && choice.token<=semantic_end), "Invalid selected semantic token");
+        if(!trace.empty()) {
+            std::vector<float> compact(slow.logits.begin()+semantic_begin,slow.logits.begin()+semantic_end+1);
+            compact.push_back(slow.logits[eos_id]);
+            write_f32(trace/("frame_"+std::to_string(frame)+"_slow_logits.f32"),compact);
+            write_f32(trace/("frame_"+std::to_string(frame)+"_slow_hidden.f32"),slow.hidden);
+        }
+        // The official implementation runs all fast positions even for EOS.
+        // This matters to the random stream, although that frame is not emitted.
+        event.codes.resize(num_codebooks);
+        event.codes[0]=std::clamp(choice.token-semantic_begin,0,codebook_size-1);
+        auto hidden=slow.hidden;
+        llama_memory_clear(llama_get_memory(engine.fast_ctx.get()),true);
+        std::vector<float> fast_trace;
+        if(!trace.empty()) { fast_trace.reserve(num_codebooks*codebook_size); }
+        const auto fast_start=clock_type::now();
+        bool aborted=false;
+        for(int p=0;p<num_codebooks;++p) {
+            if(cancel && cancel()) { result.stop_reason="cancelled";aborted=true;break; }
+            auto fast=decode(engine.fast_ctx.get(),nullptr,hidden,p,codebook_size);
+            for(float value:fast.logits) { require(std::isfinite(value),"Nonfinite fast logits"); }
+            if(!trace.empty()) { fast_trace.insert(fast_trace.end(),fast.logits.begin(),fast.logits.end()); }
+            if(p>0) {
+                bool cutoff_tie=false;
+                event.codes[p]=choose_acoustic(fast.logits,request.sampling,random,&cutoff_tie);
+                event.cutoff_tie=event.cutoff_tie || cutoff_tie;
+            }
+            if(p+1<num_codebooks) { hidden=token_embedding(engine.fast_model.get(),event.codes[p]); }
+        }
+        event.fast_ms=elapsed_ms(fast_start);
+        if(aborted) { break; }
+        if(!trace.empty()) { write_f32(trace/("frame_"+std::to_string(frame)+"_fast_logits.f32"),fast_trace); }
+        history.accept(choice.token);
+        event.emitted=choice.token!=eos_id;
+        if(event.emitted) { result.frames.push_back(event.codes); }
+        result.steps.push_back(event);
+        if(choice.token==eos_id) { result.stop_reason="eos";break; }
+        if(callback && !callback(event)) { result.stop_reason="cancelled";break; }
+        // No unused final slow query is needed after the frame budget is met.
+        if(frame+1<result.effective_max_frames) {
+            std::vector<int> column{choice.token};column.insert(column.end(),event.codes.begin(),event.codes.end());
+            input=embed_column(engine.slow_model.get(),engine.codebooks,column);
+        }
+    }
+    result.uniform_values_consumed=random.consumed();
+    result.ar_wall_ms=elapsed_ms(started);
+    return result;
+}
+} // namespace audio8
