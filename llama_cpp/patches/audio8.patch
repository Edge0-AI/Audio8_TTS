+#include "audio8-text-processor.h"
+#include "audio8-text-processor-unicode-data.h"
+#include "unicode.h"
+
+#include <algorithm>
+#include <limits>
+#include <stdexcept>
+#include <utility>
+
+namespace audio8 {
+namespace {
+
+// Python 3.10 in the pinned official environment uses Unicode 13.0.0.
+constexpr std::pair<uint32_t, uint32_t> decimal_ranges[] = {
+    {0x30, 0x39}, {0x660, 0x669}, {0x6F0, 0x6F9}, {0x7C0, 0x7C9},
+    {0x966, 0x96F}, {0x9E6, 0x9EF}, {0xA66, 0xA6F}, {0xAE6, 0xAEF},
+    {0xB66, 0xB6F}, {0xBE6, 0xBEF}, {0xC66, 0xC6F}, {0xCE6, 0xCEF},
+    {0xD66, 0xD6F}, {0xDE6, 0xDEF}, {0xE50, 0xE59}, {0xED0, 0xED9},
+    {0xF20, 0xF29}, {0x1040, 0x1049}, {0x1090, 0x1099}, {0x17E0, 0x17E9},
+    {0x1810, 0x1819}, {0x1946, 0x194F}, {0x19D0, 0x19D9}, {0x1A80, 0x1A89},
+    {0x1A90, 0x1A99}, {0x1B50, 0x1B59}, {0x1BB0, 0x1BB9}, {0x1C40, 0x1C49},
+    {0x1C50, 0x1C59}, {0xA620, 0xA629}, {0xA8D0, 0xA8D9}, {0xA900, 0xA909},
+    {0xA9D0, 0xA9D9}, {0xA9F0, 0xA9F9}, {0xAA50, 0xAA59}, {0xABF0, 0xABF9},
+    {0xFF10, 0xFF19}, {0x104A0, 0x104A9}, {0x10D30, 0x10D39}, {0x11066, 0x1106F},
+    {0x110F0, 0x110F9}, {0x11136, 0x1113F}, {0x111D0, 0x111D9}, {0x112F0, 0x112F9},
+    {0x11450, 0x11459}, {0x114D0, 0x114D9}, {0x11650, 0x11659}, {0x116C0, 0x116C9},
+    {0x11730, 0x11739}, {0x118E0, 0x118E9}, {0x11950, 0x11959}, {0x11C50, 0x11C59},
+    {0x11D50, 0x11D59}, {0x11DA0, 0x11DA9}, {0x16A60, 0x16A69}, {0x16B50, 0x16B59},
+    {0x1D7CE, 0x1D7FF}, {0x1E140, 0x1E149}, {0x1E2F0, 0x1E2F9}, {0x1E950, 0x1E959},
+    {0x1FBF0, 0x1FBF9},
+};
+
+bool python_space(uint32_t c) {
+    return (c >= 0x9 && c <= 0xD) || (c >= 0x1C && c <= 0x20) ||
+           c == 0x85 || c == 0xA0 || c == 0x1680 || (c >= 0x2000 && c <= 0x200A) ||
+           c == 0x2028 || c == 0x2029 || c == 0x202F || c == 0x205F || c == 0x3000;
+}
+
+bool python_decimal(uint32_t c) {
+    for (const auto & range : decimal_ranges) {
+        if (c < range.first) { return false; }
+        if (c <= range.second) { return true; }
+    }
+    return false;
+}
+
+bool has_speaker(const std::string & text) {
+    const auto cpts = unicode_cpts_from_utf8(text);
+    const std::string prefix = "<|speaker:";
+    for (size_t i = 0; i + prefix.size() + 2 < cpts.size(); ++i) {
+        if (!std::equal(prefix.begin(), prefix.end(), cpts.begin() + i)) { continue; }
+        size_t end = i + prefix.size();
+        while (end < cpts.size() && python_decimal(cpts[end])) { ++end; }
+        if (end > i + prefix.size() && end + 1 < cpts.size() && cpts[end] == '|' && cpts[end + 1] == '>') {
+            return true;
+        }
+    }
+    return false;
+}
+
+std::string metadata(const llama_model * model, const char * key) {
+    char value[256] = {};
+    const int32_t n = llama_model_meta_val_str(model, key, value, sizeof(value));
+    if (n < 0 || n >= int32_t(sizeof(value))) {
+        throw std::invalid_argument(std::string("Missing or oversized metadata: ") + key);
+    }
+    return {value, size_t(n)};
+}
+
+} // namespace
+
+std::string normalize_nfc(const std::string & text) {
+    std::string result;
+    std::vector<uint32_t> segment;
+    auto flush = [&]() {
+        for (uint32_t c : unicode_cpts_normalize_nfc(segment)) { result += unicode_cpt_to_utf8(c); }
+        segment.clear();
+    };
+    for (uint32_t c : unicode_cpts_from_utf8(text)) {
+        if (std::binary_search(detail::nfc_opaque_points.begin(), detail::nfc_opaque_points.end(), c)) {
+            flush();
+            result += unicode_cpt_to_utf8(c);
+        } else {
+            segment.push_back(c);
+        }
+    }
+    flush();
+    return result;
+}
+
+std::string clean_text(const std::string & text) {
+    std::string result;
+    bool pending_space = false;
+    for (uint32_t c : unicode_cpts_from_utf8(text)) {
+        if (python_space(c)) {
+            pending_space = !result.empty();
+        } else {
+            if (pending_space) { result += ' '; }
+            result += unicode_cpt_to_utf8(c);
+            pending_space = false;
+        }
+    }
+    return result;
+}
+
+std::string format_reference_text(const std::string & text) {
+    const auto cleaned = clean_text(text);
+    return has_speaker(cleaned) ? cleaned : "<|speaker:0|>" + cleaned;
+}
+
+text_processor::text_processor(const llama_model * model) : vocab_(nullptr) {
+    if (!model || metadata(model, "audio8.text.contract") != "arktts_processor_v1" ||
+        metadata(model, "audio8.text.tokenizer_sha256") != "f24e08099d45a8adf3f52f5f0b03276e433bb9d689bb15fcbcc48ce58744588b" ||
+        metadata(model, "audio8.text.processor_sha256") != "eba6ecb6b7f0e221bcd19c5e3fe5978e677faf6b362912ff4febc08c3dc7f9df" ||
+        metadata(model, "audio8.text.python_unicode_version") != "13.0.0") {
+        throw std::invalid_argument("Model does not have the pinned Realistic text contract");
+    }
+    vocab_ = llama_model_get_vocab(model);
+    if (llama_vocab_n_tokens(vocab_) != 155776 ||
+        encode("<|voice|>") != std::vector<llama_token>{151673} ||
+        encode("<|semantic:0|><|semantic:4095|>") != std::vector<llama_token>{151678, 155773}) {
+        throw std::invalid_argument("Unexpected tokenizer IDs");
+    }
+}
+
+std::vector<llama_token> text_processor::encode(const std::string & text) const {
+    const std::string normalized = normalize_nfc(text);
+    if (normalized.size() > size_t(std::numeric_limits<int32_t>::max())) {
+        throw std::length_error("Text exceeds tokenizer integer range");
+    }
+    int32_t n = llama_tokenize(vocab_, normalized.data(), int32_t(normalized.size()), nullptr, 0, false, true);
+    if (n == std::numeric_limits<int32_t>::min()) { throw std::length_error("Too many tokens"); }
+    std::vector<llama_token> tokens(size_t(n < 0 ? -n : n));
+    n = llama_tokenize(vocab_, normalized.data(), int32_t(normalized.size()), tokens.data(), int32_t(tokens.size()), false, true);
+    if (n < 0 || size_t(n) != tokens.size()) { throw std::runtime_error("Tokenizer size changed between calls"); }
+    return tokens;
+}
+
+prepared_prompt text_processor::prepare(
+    const std::string & text,
+    const std::optional<std::string> & reference_text,
+    const std::optional<std::vector<code_frame>> & reference_frames) const {
+    prepared_prompt result;
+    result.cleaned_text = clean_text(text);
+    if (result.cleaned_text.empty()) { throw std::invalid_argument("text must not be empty"); }
+    auto append = [&](std::vector<llama_token> & destination, const std::string & part) {
+        const auto ids = encode(part);
+        destination.insert(destination.end(), ids.begin(), ids.end());
+    };
+    if (!reference_frames) {
+        for (const std::string & part : std::vector<std::string>{
+                "<|im_start|>system\n", "convert the provided text to speech", "<|im_end|>\n",
+                "<|im_start|>user\n", result.cleaned_text, "<|im_end|>\n", "<|im_start|>assistant\n<|voice|>"}) {
+            append(result.prefix_ids, part);
+        }
+    } else {
+        if (!reference_text || reference_text->empty()) {
+            throw std::invalid_argument("reference_text is required when a reference voice is provided");
+        }
+        if (reference_frames->empty()) { throw std::invalid_argument("reference frames must not be empty"); }
+        result.formatted_reference_text = format_reference_text(*reference_text);
+        for (const std::string & part : std::vector<std::string>{
+                "<|im_start|>system\n", "convert the provided text to speech reference to the following:\n\nText:\n",
+                *result.formatted_reference_text, "\n\nSpeech:\n"}) {
+            append(result.prefix_ids, part);
+        }
+        for (const std::string & part : std::vector<std::string>{
+                "<|im_end|>\n", "<|im_start|>user\n", result.cleaned_text,
+                "<|im_end|>\n", "<|im_start|>assistant\n<|voice|>"}) {
+            append(result.suffix_ids, part);
+        }
+    }
+    auto text_column = [&](llama_token id) {
+        prompt_column column{};
+        column[0] = id;
+        result.prompt_columns.push_back(column);
+    };
+    for (llama_token id : result.prefix_ids) { text_column(id); }
+    if (reference_frames) {
+        for (const auto & frame : *reference_frames) {
+            prompt_column column{};
+            for (size_t i = 0; i < frame.size(); ++i) {
+                if (frame[i] < 0 || frame[i] >= 4096) { throw std::invalid_argument("reference codes must be in [0, 4095]"); }
+                column[i + 1] = frame[i];
+            }
+            column[0] = 151678 + frame[0];
+            result.prompt_columns.push_back(column);
+        }
+    }
+    for (llama_token id : result.suffix_ids) { text_column(id); }
+    result.attention_mask.assign(result.prompt_columns.size(), 1);
+    return result;
+}
+
+} // namespace audio8
diff --git a/tools/audio8/audio8-text-processor.h b/tools/audio8/audio8-text-processor.h
new file mode 100644
index 0000000..52a9fe6
