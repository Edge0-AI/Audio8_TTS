diff --git a/tools/audio8/audio8-text-processor.cmake b/tools/audio8/audio8-text-processor.cmake
new file mode 100644
index 0000000..a985d2e
--- /dev/null
+++ b/tools/audio8/audio8-text-processor.cmake
@@ -0,0 +1,50 @@
+# Include after the pinned llama target is available.
+include_guard(GLOBAL)
+if(NOT TARGET llama)
+    message(FATAL_ERROR "audio8 text processor requires the llama target")
+endif()
+if(NOT DEFINED AUDIO8_LLAMA_CPP_SOURCE_DIR)
+    message(FATAL_ERROR "Set AUDIO8_LLAMA_CPP_SOURCE_DIR to the pinned llama.cpp source")
+endif()
+
+set(_audio8_text_dir "${CMAKE_CURRENT_LIST_DIR}")
+set(_audio8_unicode_dir "${AUDIO8_LLAMA_CPP_SOURCE_DIR}/src")
+file(READ "${_audio8_text_dir}/audio8-text-processor-unicode.json" _audio8_contract)
+string(REGEX MATCH "\"source_data_sha256\": *\"([a-f0-9]+)\"" _unused "${_audio8_contract}")
+set(_audio8_data_expected "${CMAKE_MATCH_1}")
+string(REGEX MATCH "\"header_sha256\": *\"([a-f0-9]+)\"" _unused "${_audio8_contract}")
+set(_audio8_header_expected "${CMAKE_MATCH_1}")
+file(SHA256 "${_audio8_unicode_dir}/unicode-data.cpp" _audio8_data_actual)
+file(SHA256 "${_audio8_text_dir}/audio8-text-processor-unicode-data.h" _audio8_header_actual)
+if(NOT _audio8_data_actual STREQUAL _audio8_data_expected OR NOT _audio8_header_actual STREQUAL _audio8_header_expected)
+    message(FATAL_ERROR "Pinned NFC source or compatibility header hash differs")
+endif()
+
+file(READ "${_audio8_unicode_dir}/unicode.h" _audio8_unicode_header)
+file(READ "${_audio8_unicode_dir}/unicode-data.h" _audio8_unicode_data_header)
+string(REGEX MATCHALL "unicode_[A-Za-z0-9_]+" _audio8_unicode_symbols "${_audio8_unicode_header}${_audio8_unicode_data_header}")
+list(REMOVE_DUPLICATES _audio8_unicode_symbols)
+set(_audio8_unicode_renames)
+foreach(_symbol IN LISTS _audio8_unicode_symbols)
+    list(APPEND _audio8_unicode_renames "${_symbol}=audio8_text_${_symbol}")
+endforeach()
+
+add_library(audio8_text_processor STATIC
+    "${_audio8_text_dir}/audio8-text-processor.cpp"
+    "${_audio8_unicode_dir}/unicode.cpp"
+    "${_audio8_unicode_dir}/unicode-data.cpp")
+target_compile_features(audio8_text_processor PUBLIC cxx_std_17)
+set_target_properties(audio8_text_processor PROPERTIES POSITION_INDEPENDENT_CODE ON)
+target_include_directories(audio8_text_processor PUBLIC "${_audio8_text_dir}" PRIVATE "${_audio8_unicode_dir}")
+target_compile_definitions(audio8_text_processor PRIVATE ${_audio8_unicode_renames})
+target_link_libraries(audio8_text_processor PUBLIC llama)
+
+option(AUDIO8_TEXT_BUILD_CLI "Build the isolated Audio8 text JSON CLI" ON)
+if(AUDIO8_TEXT_BUILD_CLI)
+    add_executable(audio8-text-processor-cli "${_audio8_text_dir}/audio8-text-processor-cli.cpp")
+    target_include_directories(audio8-text-processor-cli PRIVATE "${AUDIO8_LLAMA_CPP_SOURCE_DIR}/vendor/nlohmann")
+    target_link_libraries(audio8-text-processor-cli PRIVATE audio8_text_processor)
+endif()
+
+install(TARGETS audio8_text_processor ARCHIVE DESTINATION lib)
+install(FILES "${_audio8_text_dir}/audio8-text-processor.h" DESTINATION include)
